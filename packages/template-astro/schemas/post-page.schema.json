{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle:post-page",
  "title": {
    "en": "Post Page",
    "zh-CN": "文章页"
  },
  "x-lang": "en",
  "x-version": "3.0.0",
  "x-migrations": [],
  "type": "object",
  "x-nav": {
    "group": "template",
    "icon": "file-text",
    "order": 2
  },
  "x-groups": {
    "postMeta": {
      "label": {
        "en": "Header & Meta",
        "zh-CN": "标题区域"
      },
      "order": 1
    }
  },
  "properties": {
    "post": {
      "type": "object",
      "x-widget": "fieldset",
      "x-order": 1,
      "title": {
        "en": "Post Page",
        "zh-CN": "文章页"
      },
      "properties": {
        "meta": {
          "type": "object",
          "x-widget": "fieldset",
          "x-order": 1,
          "title": {
            "en": "Header & Meta",
            "zh-CN": "标题区域"
          },
          "properties": {
            "metaUpdated": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 1,
              "title": {
                "en": "Show Updated Date",
                "zh-CN": "显示更新时间"
              }
            },
            "metaStats": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 2,
              "title": {
                "en": "Word Count & Reading Time",
                "zh-CN": "字数与阅读时间"
              }
            },
            "metaAiBadge": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 3,
              "title": {
                "en": "Show AI Badge",
                "zh-CN": "显示 AI 标记"
              }
            },
            "showTags": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 4,
              "title": {
                "en": "Show Tags",
                "zh-CN": "显示标签"
              }
            }
          },
          "x-group": "postMeta"
        }
      }
    }
  }
}