{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle:post-page",
  "title": {
    "en": "Post Page",
    "zh-CN": "文章页"
  },
  "x-lang": "en",
  "x-version": "3.0.0",
  "x-migrations": [],
  "type": "object",
  "x-nav": {
    "group": "template",
    "icon": "file-text",
    "order": 2
  },
  "x-groups": {
    "postCollectionNav": {
      "label": {
        "en": "Collection Navigation",
        "zh-CN": "合集导航"
      },
      "order": 3,
      "toggle": "enabled"
    }
  },
  "properties": {
    "post": {
      "type": "object",
      "x-widget": "fieldset",
      "x-order": 1,
      "title": {
        "en": "Post Page",
        "zh-CN": "文章页"
      },
      "properties": {
        "collectionNav": {
          "type": "object",
          "x-widget": "fieldset",
          "x-order": 3,
          "title": {
            "en": "Collection Navigation",
            "zh-CN": "合集导航"
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 0,
              "title": {
                "en": "Enable Collection Navigation",
                "zh-CN": "启用合集导航"
              }
            },
            "alwaysCollapsed": {
              "type": "boolean",
              "default": false,
              "x-widget": "toggle",
              "x-order": 1,
              "title": {
                "en": "Always Collapsed",
                "zh-CN": "始终折叠"
              }
            }
          },
          "x-group": "postCollectionNav"
        }
      }
    }
  }
}