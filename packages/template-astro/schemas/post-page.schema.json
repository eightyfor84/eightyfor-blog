{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle:post-page",
  "title": {
    "en": "Post Page",
    "zh-CN": "文章页"
  },
  "x-lang": "en",
  "x-version": "3.0.0",
  "x-migrations": [],
  "type": "object",
  "x-nav": {
    "group": "template",
    "icon": "file-text",
    "order": 2
  },
  "x-groups": {
    "postCollectionNav": {
      "label": {
        "en": "Collection Navigation",
        "zh-CN": "合集导航"
      },
      "order": 3,
      "toggle": "enabled"
    },
    "postComments": {
      "label": {
        "en": "Comments",
        "zh-CN": "评论区"
      },
      "order": 5,
      "toggle": "comments"
    }
  },
  "properties": {
    "comments": {
      "type": "boolean",
      "default": true,
      "x-widget": "toggle",
      "x-group": "postComments",
      "x-order": 0,
      "title": {
        "en": "Enable Comments",
        "zh-CN": "启用评论"
      },
      "description": {
        "en": "Master switch — the existing top-level comments flag in site.yml.",
        "zh-CN": "评论区总开关（site.yml 顶层现有 comments 标志）。"
      }
    },
    "post": {
      "type": "object",
      "x-widget": "fieldset",
      "x-order": 1,
      "title": {
        "en": "Post Page",
        "zh-CN": "文章页"
      },
      "properties": {
        "collectionNav": {
          "type": "object",
          "x-widget": "fieldset",
          "x-order": 3,
          "title": {
            "en": "Collection Navigation",
            "zh-CN": "合集导航"
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 0,
              "title": {
                "en": "Enable Collection Navigation",
                "zh-CN": "启用合集导航"
              }
            },
            "alwaysCollapsed": {
              "type": "boolean",
              "default": false,
              "x-widget": "toggle",
              "x-order": 1,
              "title": {
                "en": "Always Collapsed",
                "zh-CN": "始终折叠"
              }
            }
          },
          "x-group": "postCollectionNav"
        },
        "comments": {
          "type": "object",
          "x-widget": "fieldset",
          "x-order": 5,
          "title": {
            "en": "Comments",
            "zh-CN": "评论区"
          },
          "properties": {
            "backend": {
              "type": "string",
              "default": "",
              "enum": [
                "",
                "waline"
              ],
              "x-widget": "select",
              "x-order": 1,
              "x-options": [
                {
                  "value": "",
                  "label": {
                    "en": "Static JSON (no interaction)",
                    "zh-CN": "静态 JSON（无交互）"
                  }
                },
                {
                  "value": "waline",
                  "label": {
                    "en": "Waline (headless API)",
                    "zh-CN": "Waline（headless API）"
                  }
                }
              ],
              "title": {
                "en": "Backend",
                "zh-CN": "后端"
              }
            },
            "walineServerUrl": {
              "type": "string",
              "default": "",
              "maxLength": 256,
              "x-widget": "input",
              "x-order": 2,
              "x-visible-when": {
                "field": "backend",
                "equals": "waline"
              },
              "title": {
                "en": "Waline Server URL",
                "zh-CN": "Waline 服务地址"
              }
            },
            "attitude": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 3,
              "x-visible-when": {
                "field": "backend",
                "equals": "waline"
              },
              "title": {
                "en": "Post Attitude (Like / Dislike)",
                "zh-CN": "文章态度（点赞 / 点踩）"
              },
              "description": {
                "en": "Rendered via the Waline reaction API. Hidden when the backend is not Waline.",
                "zh-CN": "通过 Waline reaction API 渲染；后端非 Waline 时隐藏。"
              }
            },
            "showGeoAddress": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 4,
              "x-visible-when": {
                "field": "backend",
                "equals": "waline"
              },
              "title": {
                "en": "Show Commenter Location",
                "zh-CN": "显示评论者地区"
              },
              "description": {
                "en": "Shows the geo address (e.g. China · Beijing) derived from IP, never the raw IP. Omitted when unavailable.",
                "zh-CN": "展示 IP 对应的地理地址（如「中国 北京市」），绝不显示原始 IP；取不到时省略。"
              }
            },
            "$waline_admin": {
              "type": "null",
              "x-chronicle-class": "waline-admin-link",
              "x-order": 5,
              "x-visible-when": {
                "field": "backend",
                "equals": "waline"
              },
              "title": {
                "en": "Open Waline Admin",
                "zh-CN": "打开 Waline 后台"
              },
              "description": {
                "en": "Comment moderation is delegated to the Waline admin dashboard at <server>/ui.",
                "zh-CN": "评论管理已委托 Waline 管理后台（<server>/ui）。"
              }
            },
            "imageUploadEnabled": {
              "type": "boolean",
              "default": false,
              "x-widget": "toggle",
              "x-order": 6,
              "title": {
                "en": "Allow Images in Comments",
                "zh-CN": "允许评论带图片"
              },
              "description": {
                "en": "Upload images to the image host configured below. Off: comments cannot include images.",
                "zh-CN": "上传图片到下方配置的图床；关闭则评论不可带图。"
              }
            },
            "imageUploadEndpoint": {
              "type": "string",
              "default": "",
              "x-widget": "input",
              "x-order": 7,
              "x-visible-when": {
                "field": "imageUploadEnabled",
                "equals": true
              },
              "title": {
                "en": "Image Host Upload URL",
                "zh-CN": "图床上传地址"
              },
              "description": {
                "en": "POST multipart file; response JSON url field (lsky-pro style: data.links.url).",
                "zh-CN": "POST multipart file，响应 JSON 取 url（lsky-pro 风格：data.links.url）。"
              }
            },
            "imageUploadToken": {
              "type": "string",
              "default": "",
              "x-widget": "input",
              "x-order": 8,
              "x-visible-when": {
                "field": "imageUploadEnabled",
                "equals": true
              },
              "title": {
                "en": "Image Host Token",
                "zh-CN": "图床令牌"
              },
              "description": {
                "en": "Sent as Authorization: Bearer <token>.",
                "zh-CN": "以 Authorization: Bearer <token> 发送。"
              }
            }
          },
          "x-group": "postComments"
        }
      }
    }
  }
}