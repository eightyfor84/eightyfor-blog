{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle:comments-config",
  "title": {
    "en": "Comments",
    "zh-CN": "评论"
  },
  "x-lang": "en",
  "x-version": "1.0.0",
  "x-migrations": [],
  "type": "object",
  "x-nav": {
    "group": "template",
    "tabs": {
      "": {
        "label": {
          "en": "Comments",
          "zh-CN": "评论"
        },
        "icon": "message-circle",
        "order": 6
      }
    }
  },
  "x-groups": {
    "backend": {
      "title": {
        "en": "Comment Backend",
        "zh-CN": "评论后端"
      },
      "order": 1
    }
  },
  "properties": {
    "comment": {
      "type": "object",
      "x-widget": "fieldset",
      "x-group": "backend",
      "x-order": 1,
      "title": {
        "en": "Comment Backend",
        "zh-CN": "评论后端"
      },
      "description": {
        "en": "Choose how comments are stored and submitted. Changes take effect on next build.",
        "zh-CN": "选择评论的存储和提交方式。修改后需重新构建站点生效。"
      },
      "properties": {
        "backend": {
          "type": "string",
          "default": "",
          "enum": ["", "waline"],
          "x-widget": "select",
          "x-order": 1,
          "title": {
            "en": "Backend",
            "zh-CN": "后端"
          },
          "description": {
            "en": "Static JSON (no interaction) / Waline (headless API, Chronicle-rendered UI)",
            "zh-CN": "静态 JSON（无交互）/ Waline（headless API，Chronicle 自绘 UI）"
          },
          "x-options": [
            { "value": "", "label": { "en": "Static JSON (no interaction)", "zh-CN": "静态 JSON（无交互）" } },
            { "value": "waline", "label": { "en": "Waline (headless API)", "zh-CN": "Waline（headless API）" } }
          ]
        },
        "walineServerUrl": {
          "type": "string",
          "default": "",
          "maxLength": 256,
          "x-widget": "input",
          "x-order": 6,
          "x-visible-when": { "field": "backend", "equals": "waline" },
          "title": {
            "en": "Waline Server URL",
            "zh-CN": "Waline 服务地址"
          },
          "description": {
            "en": "Waline server URL (Vercel / LeanCloud / Deta deployment).",
            "zh-CN": "Waline 服务地址（Vercel / LeanCloud / Deta 部署）。"
          }
        }
      }
    },
    "$waline_admin": {
      "type": "null",
      "x-chronicle-class": "waline-admin-link",
      "x-group": "backend",
      "x-order": 2,
      "x-visible-when": { "field": "comment.backend", "equals": "waline" },
      "title": {
        "en": "Open Waline Admin",
        "zh-CN": "打开 Waline 后台"
      },
      "description": {
        "en": "Jump to the Waline admin dashboard to review, approve, hide, or delete comments. Opens in your default browser at <server>/ui.",
        "zh-CN": "跳转到 Waline 管理后台，用于审核、批准、隐藏或删除评论。点击后将在默认浏览器打开 <server>/ui。"
      }
    }
  }
}
