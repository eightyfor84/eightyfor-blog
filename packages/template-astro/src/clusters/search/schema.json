{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle:search",
  "title": {
    "en": "Search",
    "zh-CN": "搜索"
  },
  "description": {
    "en": "Search cluster settings",
    "zh-CN": "检索簇设置（chronicle-search）"
  },
  "type": "object",
  "x-nav": {
    "group": "template",
    "icon": "search",
    "order": 4
  },
  "x-groups": {
    "general": {
      "label": {
        "en": "General",
        "zh": "通用"
      }
    }
  },
  "properties": {
    "search": {
      "type": "object",
      "x-widget": "fieldset",
      "title": {
        "en": "Search",
        "zh-CN": "搜索"
      },
      "properties": {
        "searchSuggestions": {
          "type": "boolean",
          "default": true,
          "x-widget": "toggle",
          "x-tab": "template-search",
          "x-group": "general",
          "x-order": 1,
          "title": {
            "en": "Search Suggestions",
            "zh-CN": "搜索建议"
          },
          "description": {
            "en": "Show search suggestions as users type.",
            "zh-CN": "在用户输入时显示搜索建议。"
          }
        },
        "globalSearch": {
          "type": "boolean",
          "default": true,
          "x-widget": "toggle",
          "x-tab": "template-search",
          "x-group": "general",
          "x-order": 2,
          "title": {
            "en": "Global Search",
            "zh-CN": "全局搜索"
          },
          "description": {
            "en": "Show a Spotlight-style search overlay on all pages (Ctrl/Cmd+K or /).",
            "zh-CN": "在所有页面用 Ctrl/Cmd+K 或 / 调出 Spotlight 式全局搜索遮罩。"
          }
        },
        "fullTextSearch": {
          "type": "boolean",
          "default": true,
          "x-widget": "toggle",
          "x-tab": "template-search",
          "x-group": "general",
          "x-order": 3,
          "title": {
            "en": "Full-Text Search",
            "zh-CN": "全文搜索"
          },
          "description": {
            "en": "Index post body text for full-text search (generates full_index.json at build time).",
            "zh-CN": "构建时生成含正文的 full_index.json 索引，支持全文搜索。"
          }
        }
      },
      "x-tab": "template-search"
    }
  }
}