---
import './styles/search-experience.css';
import SearchBox from "./SearchBox.astro";

interface Props {
  mode?: 'page' | 'overlay';
  locale?: string;
  routePrefix?: string;
  t?: (key: string) => string;
  searchSuggestionsEnabled?: boolean;
  fullTextSearchEnabled?: boolean;
  indexUrl?: string;
  fullIndexUrl?: string;
  initialTitle?: string;
  initialTags?: string[];
  featuredLabel?: string;
}

const {
  mode = 'page',
  locale = 'zh-CN',
  routePrefix = '/zh',
  t = (key: string) => key,
  searchSuggestionsEnabled = false,
  fullTextSearchEnabled = false,
  indexUrl = '/posts/index.json',
  fullIndexUrl = '/posts/full_index.json',
  initialTitle = '',
  initialTags = [],
  featuredLabel = '',
} = Astro.props;

const instanceId = mode === 'overlay' ? 'search-overlay-searchbox' : 'search-page-searchbox';
const resultsTitleText = t('search.resultsTitle');
const resultsCountText = t('search.resultsCount').replace('{count}', '0');

// SSR-injected client i18n (single source = locales JSON). search-engine.ts
// reads this — no builtin translation table in client code.
const searchI18n: Record<string, string> = {
  'search.tagsCount': t('search.tagsCount'),
  'search.resultDescription': t('search.resultDescription'),
  'search.allPosts': t('search.allPosts'),
  'search.items': t('search.items'),
  'search.resultsTitle': t('search.resultsTitle'),
  'search.resultsCount': t('search.resultsCount'),
  'search.suggestionEmpty': t('search.suggestionEmpty'),
};

// Serialized to the DOM so the lazy-loaded search engine can read it without
// inlining the heavy engine into every page's HTML.
const searchConfig = {
  instanceId,
  mode,
  locale,
  routePrefix,
  searchSuggestionsEnabled,
  fullTextSearchEnabled,
  indexUrl,
  fullIndexUrl,
  initialTitle,
  initialTags,
  featuredLabel,
};
---

<div
  class:list={[
    "search-experience",
    mode === "page" ? "page-container centered-mode" : "overlay-experience",
  ]}
  data-search-experience={instanceId}
  data-mode={mode}
  data-search-config={JSON.stringify(searchConfig)}
>
  <script type="application/json" data-role="search-i18n" set:html={JSON.stringify(searchI18n)}></script>
  <SearchBox
    instanceId={instanceId}
    searchSuggestionsEnabled={searchSuggestionsEnabled}
    showTagTrigger={true}
    initialTitle={initialTitle}
    featuredLabel={featuredLabel}
    routePrefix={routePrefix}
    t={t}
    searchOnEnter={true}
    searchBtnAsButton={true}
  />

  <div class="content-wrapper" id="content-wrapper" style="display:none;">
    <div class="tag-cloud-container" id="tag-cloud" style="display:none;">
      <div
        class="selected-tags-header"
        id="selected-tags-header"
        style="display:none;"
      >
        <h3>{t("search.selectedTags")}</h3>
        <div class="selected-tags-list" id="selected-tags-list"></div>
      </div>
      <div class="content-scroll-area">
        <div class="tags-grid" id="tags-grid"></div>
        <div class="cloud-btm-barrier">
        </div>
      </div>
    </div>

    <div class="suggestion-list" id="suggestion-list" style="display:none;"></div>

    <div class="results-container" id="results-container">
      <div class="results-header" id="results-header" style="display:none;">
        <h3 id="results-title">{resultsTitleText}</h3>
        <span class="results-count" id="results-count">{resultsCountText}</span>
      </div>
      <div class="content-scroll-area">
        <div class="results-list" id="results-list">
          <div class="loading" id="loading-state">{t("search.loading")}</div>
          <div class="empty" id="empty-state" style="display:none;">
            {t("search.noResults")}
          </div>
          <div class="results-list" id="results-content"></div>
        </div>
      </div>
    </div>
  </div>
</div>



<script>
  import './scripts/search-bootstrap';
</script>
