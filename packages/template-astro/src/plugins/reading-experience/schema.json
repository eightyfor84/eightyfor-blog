{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chronicle:reading-experience",
  "title": {
    "en": "Reading Experience",
    "zh-CN": "阅读体验"
  },
  "description": {
    "en": "Reading experience plugin settings (TOC, article meta, end-of-article blocks)",
    "zh-CN": "阅读体验插件设置：目录、文章头部信息、文末区块（相关/上下篇/分享/态度/作者卡）"
  },
  "type": "object",
  "x-nav": {
    "group": "template",
    "icon": "book",
    "order": 6
  },
  "x-groups": {
    "postToc": {
      "label": {
        "en": "Table of Contents",
        "zh-CN": "目录控件"
      },
      "order": 2,
      "toggle": "enabled"
    },
    "postEndOfArticle": {
      "label": {
        "en": "End of Article",
        "zh-CN": "文章末尾"
      },
      "order": 4
    }
  },
  "properties": {
    "post": {
      "type": "object",
      "properties": {
        "toc": {
          "type": "object",
          "x-widget": "fieldset",
          "x-order": 2,
          "title": {
            "en": "Table of Contents",
            "zh-CN": "目录控件"
          },
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 0,
              "title": {
                "en": "Enable TOC",
                "zh-CN": "启用目录"
              }
            },
            "inlineToc": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 1,
              "title": {
                "en": "Inline TOC",
                "zh-CN": "行内目录"
              }
            },
            "tocFloat": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 2,
              "title": {
                "en": "Floating TOC",
                "zh-CN": "悬浮目录"
              }
            },
            "tocFloatAlwaysExpanded": {
              "type": "boolean",
              "default": false,
              "x-widget": "toggle",
              "x-order": 5,
              "title": {
                "en": "Always Expanded Floating TOC",
                "zh-CN": "悬浮目录始终展开"
              },
              "description": {
                "en": "Permanently expanded floating TOC — no background/blur, items never collapse to lines, content reserves right space. Overrides the collapse toggle.",
                "zh-CN": "悬浮目录始终保持展开——无背景/无模糊、条目不折叠成线、正文让出右侧空间。优先于折叠开关。"
              }
            },
            "mobileTocControl": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 4,
              "title": {
                "en": "Mobile TOC Control",
                "zh-CN": "移动端目录控件"
              }
            }
          },
          "x-group": "postToc"
        },
        "endOfArticle": {
          "type": "object",
          "x-widget": "fieldset",
          "x-order": 4,
          "title": {
            "en": "End of Article",
            "zh-CN": "文章末尾"
          },
          "properties": {
            "relatedPosts": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 1,
              "title": {
                "en": "Related Posts",
                "zh-CN": "相关文章"
              },
              "description": {
                "en": "Derived at build time from shared tags/collections (3 posts).",
                "zh-CN": "构建期按标签/合集相似度派生（3 篇）。"
              }
            },
            "prevNext": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 2,
              "title": {
                "en": "Prev / Next Navigation",
                "zh-CN": "前后导航"
              }
            },
            "prevNextMode": {
              "type": "string",
              "default": "both",
              "x-widget": "radio-group",
              "x-order": 3,
              "x-options": [
                {
                  "value": "both",
                  "label": {
                    "en": "Both prev & next",
                    "zh-CN": "上一篇 + 下一篇"
                  }
                },
                {
                  "value": "next-only",
                  "label": {
                    "en": "Next only",
                    "zh-CN": "只显示下一篇"
                  }
                }
              ],
              "title": {
                "en": "Navigation Mode",
                "zh-CN": "导航模式"
              },
              "x-visible-when": {
                "field": "prevNext",
                "equals": true
              }
            },
            "prevNextScope": {
              "type": "string",
              "default": "collection",
              "x-widget": "radio-group",
              "x-order": 4,
              "x-options": [
                {
                  "value": "global",
                  "label": {
                    "en": "All posts (by date)",
                    "zh-CN": "全部文章（按日期）"
                  }
                },
                {
                  "value": "collection",
                  "label": {
                    "en": "Within the same collection",
                    "zh-CN": "同合集内"
                  }
                }
              ],
              "title": {
                "en": "Navigation Scope",
                "zh-CN": "导航范围"
              },
              "x-visible-when": {
                "field": "prevNext",
                "equals": true
              }
            },
            "prevNextOrder": {
              "type": "string",
              "default": "desc",
              "x-widget": "radio-group",
              "x-order": 5,
              "x-options": [
                {
                  "value": "desc",
                  "label": {
                    "en": "Newest first (first = latest)",
                    "zh-CN": "最新在前（第一篇 = 最新）"
                  }
                },
                {
                  "value": "asc",
                  "label": {
                    "en": "Oldest first (first = earliest)",
                    "zh-CN": "最老在前（第一篇 = 最老）"
                  }
                }
              ],
              "title": {
                "en": "Navigation Order",
                "zh-CN": "导航排序"
              },
              "description": {
                "en": "Direction for all-posts ordering (scope: All posts). Collection order is defined by collections.yml and unaffected.",
                "zh-CN": "全部拉通（范围：全部文章）时的排序方向。合集内顺序由 collections.yml 定义，不受此设置影响。"
              },
              "x-visible-when": {
                "field": "prevNext",
                "equals": true
              },
              "x-disabled-when": {
                "field": "prevNextScope",
                "equals": "collection"
              },
              "x-disabled-text": {
                "en": "Unused while scope is \"Within the same collection\" — collection order comes from collections.yml.",
                "zh-CN": "范围选择「同合集内」时不生效——合集内顺序由 collections.yml 定义。"
              }
            },
            "authorCard": {
              "type": "boolean",
              "default": false,
              "x-widget": "toggle",
              "x-order": 6,
              "title": {
                "en": "Author Card",
                "zh-CN": "作者卡片"
              }
            },
            "share": {
              "type": "boolean",
              "default": true,
              "x-widget": "toggle",
              "x-order": 7,
              "title": {
                "en": "Share Article",
                "zh-CN": "分享文章"
              }
            },
            "shareChannels": {
              "type": "array",
              "default": [
                "twitter",
                "linkedin",
                "weibo"
              ],
              "items": {
                "type": "string",
                "enum": [
                  "twitter",
                  "weibo",
                  "linkedin"
                ]
              },
              "x-widget": "card-list",
              "x-card-intro": false,
              "x-order": 8,
              "x-item-labels": {
                "twitter": {
                  "en": "Twitter / X",
                  "zh-CN": "Twitter / X"
                },
                "weibo": {
                  "en": "Weibo",
                  "zh-CN": "微博"
                },
                "linkedin": {
                  "en": "LinkedIn",
                  "zh-CN": "领英"
                }
              },
              "title": {
                "en": "Share Channels",
                "zh-CN": "分享渠道"
              },
              "description": {
                "en": "Sortable channel list — order matters for rendering.",
                "zh-CN": "可排序渠道列表，顺序即渲染顺序。"
              },
              "x-visible-when": {
                "field": "share",
                "equals": true
              },
              "x-card-editable": false
            }
          },
          "x-group": "postEndOfArticle"
        }
      },
      "x-widget": "fieldset"
    }
  }
}