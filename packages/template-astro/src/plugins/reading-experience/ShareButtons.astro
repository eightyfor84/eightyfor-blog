---
import './styles/share-buttons.css';
interface Props {
  post: any;
  locale: string;
  lang: string;
  channels?: string[];
}
const { post, locale, lang, channels = ['twitter', 'weibo', 'linkedin'] } = Astro.props as Props;
const postUrl = `/${lang}/post/${encodeURIComponent(post?.id || '')}`;
const postTitle = String(post?.title || '');

// 渠道定义表（有标准网页分享 URL 的社交渠道）：显隐与顺序由 channels 数组驱动；加渠道 = 加表项 + script 分支
// 微信/朋友圈无网页分享 API → 合进下方 system 按钮（Web Share API，系统面板选微信/朋友圈）
const CHANNEL_DEFS: Record<string, { icon: string }> = {
  twitter: {
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  },
  weibo: {
    // 官方 Sina Weibo 品牌图标（Simple Icons 收录，微博红 #E6162D）
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M10.098 20.323c-3.977.391-7.414-1.406-7.672-4.02-.259-2.609 2.759-5.047 6.74-5.441 3.979-.394 7.413 1.404 7.671 4.018.259 2.6-2.759 5.049-6.737 5.439l-.002.004zM9.05 17.219c-.384.616-1.208.884-1.829.602-.612-.279-.793-.991-.406-1.593.379-.595 1.176-.861 1.793-.601.622.263.82.972.442 1.592zm1.27-1.627c-.141.237-.449.353-.689.253-.236-.09-.313-.361-.177-.586.138-.227.436-.346.672-.24.239.09.315.36.18.601l.014-.028zm.176-2.719c-1.893-.493-4.033.45-4.857 2.118-.836 1.704-.026 3.591 1.886 4.21 1.983.64 4.318-.341 5.132-2.179.8-1.793-.201-3.642-2.161-4.149zm7.563-1.224c-.346-.105-.57-.18-.405-.615.375-.977.42-1.804 0-2.404-.781-1.112-2.915-1.053-5.364-.03 0 0-.766.331-.571-.271.376-1.217.315-2.224-.27-2.809-1.338-1.337-4.869.045-7.888 3.08C1.309 10.87 0 13.273 0 15.348c0 3.981 5.099 6.395 10.086 6.395 6.536 0 10.888-3.801 10.888-6.82 0-1.822-1.547-2.854-2.915-3.284v.01zm1.908-5.092c-.766-.856-1.908-1.187-2.96-.962-.436.09-.706.511-.616.932.09.42.511.691.932.602.511-.105 1.067.044 1.442.465.376.421.466.977.316 1.473-.136.406.089.856.51.992.405.119.857-.105.992-.512.33-1.021.12-2.178-.646-3.035l.03.045zm2.418-2.195c-1.576-1.757-3.905-2.419-6.054-1.968-.496.104-.812.587-.706 1.081.104.496.586.813 1.082.707 1.532-.331 3.185.15 4.296 1.383 1.112 1.246 1.429 2.943.947 4.416-.165.48.106 1.007.586 1.157.479.165.991-.104 1.157-.586.675-2.088.241-4.478-1.338-6.235l.03.045z"/></svg>',
  },
  linkedin: {
    // 官方 LinkedIn 品牌图标（Simple Icons 收录）
    icon: '<svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  },
};
// 始终可用（不受 shareChannels 设置控制）：
//  system —— Web Share API（navigator.share，系统面板含微信/朋友圈；不支持时降级复制链接）
//  copy  —— 复制链接
const SYSTEM_ICON = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>';
const COPY_ICON = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
---
<div class="share-btns">
  {channels.map((kind: string) => {
    const def = CHANNEL_DEFS[kind];
    if (!def) return null;
    return (
      <button type="button" class="share-btn" data-share={kind} data-url={postUrl} data-title={postTitle} aria-label={kind}>
        <span set:html={def.icon} />
      </button>
    );
  })}
  <button type="button" class="share-btn" data-share="system" data-url={postUrl} data-title={postTitle} aria-label="System share">
    <span set:html={SYSTEM_ICON} />
  </button>
  <button type="button" class="share-btn" data-share="copy" data-url={postUrl} aria-label="Copy link">
    <span set:html={COPY_ICON} />
  </button>
</div>

<script is:inline>
  (() => {
    const base = location.origin;
    // 复制成功后图标变对钩，1.5s 后恢复
    const DONE_ICON = '<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
    const done = (btn) => {
      const old = btn.innerHTML;
      btn.innerHTML = DONE_ICON;
      setTimeout(() => { btn.innerHTML = old; }, 1500);
    };
    const bind = () => {
    document.addEventListener('click', (e) => {
      const btn = (e.target).closest?.('.share-btn');
      if (!btn) return;
      const kind = btn.dataset.share;
      const rel = btn.dataset.url || '';
      const title = btn.dataset.title || document.title;
      const abs = rel.startsWith('http') ? rel : base + (rel.startsWith('/') ? rel : '/' + rel);
      if (kind === 'twitter') {
        window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'weibo') {
        window.open('https://service.weibo.com/share/share.php?title=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'linkedin') {
        window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'system') {
        // Web Share API：系统分享面板（移动端含微信/朋友圈）；不支持则降级复制链接
        if (navigator.share) {
          navigator.share({ title, url: abs }).catch(() => {});
        } else {
          copyText(abs, btn);
        }
      } else if (kind === 'copy') {
        copyText(abs, btn);
      }
    });
    function copyText(text, btn) {
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(text).then(() => done(btn)).catch(() => fallbackCopy(text, btn));
      } else {
        fallbackCopy(text, btn);
      }
    }
    function fallbackCopy(text, btn) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(btn); } catch {}
      document.body.removeChild(ta);
    }
    };

    // 进视口才绑定分享事件（底部控件懒加载——脚本按需初始化）
    const root = document.querySelector('.share-btns');
    if (root) {
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries, obs) => {
          if (entries.some(e => e.isIntersecting)) { obs.disconnect(); bind(); }
        });
        io.observe(root);
      } else {
        bind();
      }
    }
  })();
</script>


