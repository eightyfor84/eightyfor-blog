---
// ── 导航搜索按钮（遮罩式搜索入口）：search 插件注册 ──────────────
// 主板 NavHeader 通过槽位 nav-search-action 渲染本组件；插件禁用/删除 →
// 构建期不注册 → 按钮消失（注册式，core 不预知按钮）；globalSearch 配置
// 关闭 → when.featureFlag 门控不过 → 按钮消失（与遮罩弹层同 flag 同步）。
import { buildLocalizedPath } from '../../utils/routeLocale';

interface Props {
  locale?: string;
  /** 当前路由路径（不含语言前缀）——用于 /search 高亮 */
  activePath?: string;
  t?: (key: string) => string;
}

const { locale = 'zh-CN', activePath = '', t = (key: string) => key } = Astro.props;
const searchHref = buildLocalizedPath(locale, '/search');
const isActive = activePath.startsWith('/search');
---

<a
  href={searchHref}
  class:list={["nav-action-link", "nav-search-btn", { "router-link-active": isActive }]}
  data-global-search="true"
  aria-label={t("nav.search")}
  title={t("nav.search")}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <line x1="16.65" y1="16.65" x2="21" y2="21"></line>
  </svg>
</a>
