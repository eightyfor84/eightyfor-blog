---
// ── 文章 tag 链接（post-tags 槽位）：search 插件注册 ────────────
// 渲染文章 tags 的搜索链接（/search?tags=）——tag 功能依赖搜索页，随插件注册：
// 搜索禁用/删除 → 构建期不注册 → 文章页/slides 视图的 tag 链接消失（展示保留）。
import { buildLocalizedPath } from '../../utils/routeLocale';

interface Props {
  /** 文章 tags */
  tags?: string[];
  /** 路由语言前缀（'zh' | 'en'）——用于拼 /search?tags= 链接 */
  routeLang?: string;
  /** 渲染变体：'post'（文章页 tag-link）| 'slide'（slides 视图 slide-tag-chip） */
  variant?: 'post' | 'slide';
}

const { tags = [], routeLang = 'zh', variant = 'post' } = Astro.props as Props;
const searchForTags = buildLocalizedPath(routeLang, '/search?tags=');
const isSlide = variant === 'slide';
---

{tags.length > 0 && (
  isSlide ? (
    <span class="slide-info-tags">
      {tags.map((tag: string) => (
        <a href={searchForTags + encodeURIComponent(tag)} class="slide-tag-chip">
          {tag}
        </a>
      ))}
    </span>
  ) : (
    <div class="post-tags">
      {tags.map((tag: string) => (
        <a
          href={searchForTags + encodeURIComponent(tag)}
          class="tag-link"
          aria-label={`Search for tag ${tag}`}
        >
          <span
            class="tag"
            class:list={[{ featured: tag === 'featured' || tag === '精选' }]}
          >
            {tag}
          </span>
        </a>
      ))}
    </div>
  )
)}
