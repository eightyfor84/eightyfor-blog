---
import { ClientRouter } from 'astro:transitions';
import NavHeader from '../components/NavHeader.astro';
import FilePreviewModal from '../components/FilePreviewModal.astro';
import GlobalSearchOverlay from '../components/GlobalSearchOverlay.astro';
import { getLocale, getTranslation } from '../utils/i18n';
import { resolveFeatureFlags } from '../utils/featureFlags';
import { theme as themeManifest } from '../themes/aurora/manifest';
import ThemeInit from '../themes/aurora/components/ThemeInit.astro';
import ThemeVars from '../themes/aurora/components/ThemeVars.astro';
import ThemeRuntime from '../themes/aurora/components/ThemeRuntime.astro';
import chronicleMarkdownCss from '@chronicle/shared/src/styles/chronicle-markdown.css?raw';
import '../themes/aurora/styles/global.css';
import '../themes/aurora/styles/app.css';

import { hexToRgbString } from '../utils/colorUtils';

// ── Critical CSS：由主题 manifest 驱动（自动识别）────────────
// 页型 → CSS 文件的映射在 themes/<name>/manifest.ts 声明；
// 这里通过 glob 按 manifest 里的文件名取 raw 内容。
// 主题缺省的页型自动跳过（返回 ''），允许主题只声明部分页型。
const criticalRaw = import.meta.glob<string>('../themes/aurora/styles/*.css', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const themeCss = (name: string) => criticalRaw[`../themes/aurora/styles/${name}`] ?? '';
const criticalTokens = themeCss(themeManifest.tokens);

// Assemble critical CSS based on page type — only inject what this page needs.
const pathname = Astro.url.pathname;
const isHome = /^\/(en|zh)\/?$/.test(pathname);
const isPost = pathname.includes('/post/');
const isAbout = /^\/(en|zh)\/about\/?$/.test(pathname);
const isBlogs = /\/(en|zh)\/blogs\/?$/.test(pathname);
const isSearch = pathname.includes('/search');
const isFriends = /\/(en|zh)\/friends\/?$/.test(pathname);
// chronicle-markdown.css is inlined for post/about pages instead of a
// render-blocking <link>: a separate request for it gated FCP with huge
// run-to-run variance (observed arrival 138ms–1063ms → lab FCP 1.7s–5.9s).
// The built file is only ~21KB raw; inlining removes the request entirely.
// Order: after criticalPost, so its .chr-md rules keep winning the cascade
// (same as the old link-after-inline-style behavior).
const criticalCSS = [
  themeCss(themeManifest.critical.base),
  isHome    ? themeCss(themeManifest.critical.home)    : '',
  isPost    ? themeCss(themeManifest.critical.post)    : '',
  (isPost || isAbout) ? chronicleMarkdownCss : '',
  isBlogs   ? themeCss(themeManifest.critical.blogs)   : '',
  isSearch  ? themeCss(themeManifest.critical.search)  : '',
  isFriends ? themeCss(themeManifest.critical.friends) : '',
].join('');

export interface Props {
  title?: string;
  settings?: any;
  locale?: 'en' | 'zh-CN';
  meta?: string | {
    title?: string;
    description?: string;
    keywords?: string[] | string;
    type?: string;
    image?: string;
    url?: string;
    robots?: string;
    noIndex?: boolean;
  };
  navTitle?: string;
  navBackHref?: string;
  navBackLabel?: string;
  scrollable?: boolean;
  featureFlags?: Record<string, boolean>;
  disableMainContentTransition?: boolean;
}

const { title, settings, locale: propLocale, meta, navTitle, navBackHref, navBackLabel, scrollable, disableMainContentTransition } = Astro.props;
const pageMeta = typeof meta === 'string' ? { description: meta } : (meta || {});
const featureFlags = resolveFeatureFlags(settings?.featureFlags || Astro.props.featureFlags);
const mediaDomain = String(process.env.MEDIA_DOMAIN || '').replace(/\/$/, '');

function resolveMediaUrl(value: any) {
  const normalized = String(value || '').trim();
  if (!normalized) return '';
  if (/^https?:\/\//i.test(normalized)) return normalized;
  return normalized;
}

function normalizeLayoutBackground(raw: any) {
  if (!raw) return '';
  if (typeof raw === 'string') return resolveMediaUrl(raw);
  if (typeof raw !== 'object') return '';

  const backgroundUrl = resolveMediaUrl(raw.url || raw.path || raw.backgroundUrl || raw.generatedPath || raw.sourcePath || '');
  return {
    ...raw,
    url: backgroundUrl,
    path: String(raw.path || raw.generatedPath || raw.sourcePath || '').replace(/^\/+/, ''),
    generatedPath: String(raw.generatedPath || raw.path || '').replace(/^\/+/, ''),
  };
}

const siteTitle = settings?.siteName || 'Chronicle';
const displayTitle = title ? `${title} - ${siteTitle}` : siteTitle;
const metaTitle = pageMeta.title ? `${pageMeta.title} - ${siteTitle}` : displayTitle;
const metaDescription = String(pageMeta.description || '').trim();
const metaKeywords = Array.isArray(pageMeta.keywords)
  ? pageMeta.keywords.filter(Boolean).join(', ')
  : String(pageMeta.keywords || '').trim();
const metaType = String(pageMeta.type || 'website').trim();
const metaImage = String(pageMeta.image || '').trim();
const metaUrl = String(pageMeta.url || '').trim();
const metaRobots = String(pageMeta.robots || (pageMeta.noIndex ? 'noindex,nofollow' : '')).trim();

// 从settings获取样式配置
const theme = settings?.theme || 'follow';
const accent = settings?.accent || '#2ea35f';
const background = normalizeLayoutBackground(settings?.background || '');
const backgroundMetaRaw = settings?.backgroundMeta || null;
const backgroundColorLight = settings?.baseColorLight || settings?.backgroundColorLight || '';
const backgroundColorDark = settings?.baseColorDark || settings?.backgroundColorDark || '';
const font = settings?.font || 'sans';
const defaultPerformanceMode = settings?.defaultPerformanceMode || 'auto';

// ── Background layer: resolve build-time CSS values ──
// The background image URL, mode-derived size/position/repeat, blur, and the
// light/dark overlay + surface colors are all known at build time. Emit them as
// static CSS so no runtime JS is needed to render the background layer.
const backgroundImageUrl = typeof background === 'string'
  ? background
  : (background && (background as any).url) || '';

let backgroundMeta: any = null;
try {
  backgroundMeta = backgroundMetaRaw ? JSON.parse(String(backgroundMetaRaw)) : null;
} catch (e) { backgroundMeta = null; }

// ── Background video (optional) — preload="none" so it never competes with the
//    page skeleton; the fallback image below shows first, and the video fades in
//    over it once its first frame is decodable (layout-init.ts) ──
const backgroundVideoUrl = typeof settings?.backgroundVideo === 'string'
  ? settings.backgroundVideo
  : '';
// Explicit fallback first-frame poster (background_alt.<ext>) — shown as the
// static bg-image while the video loads (no native `poster` attr, to avoid the
// cached-refresh poster flash).
const backgroundPosterUrl = typeof settings?.backgroundPoster === 'string'
  ? settings.backgroundPoster
  : '';
const videoAutoplay = backgroundMeta?.videoAutoplay !== false;   // default true
const videoLoop = backgroundMeta?.videoLoop !== false;           // default true
const videoPlaybackRate = Number(backgroundMeta?.videoPlaybackRate ?? 1) || 1;

// Fallback static image shown first (below the video). With a video, prefer the
// poster (first frame); otherwise the main background image. It stays permanently
// — the graceful fallback when the video errors or is paused.
const fallbackImageUrl = backgroundVideoUrl
  ? (backgroundPosterUrl || backgroundImageUrl)
  : backgroundImageUrl;

// Compressed-variant candidates (avif > webp > original) for whichever fallback
// image was chosen. Serialized to data-bg-image as JSON; layout-init.ts probes
// them in order after FCP and uses the first that decodes → smallest bytes.
const fallbackCandidates = backgroundVideoUrl
  ? (settings?.backgroundPosterCandidates?.length
      ? settings.backgroundPosterCandidates
      : settings?.backgroundCandidates ?? [])
  : (settings?.backgroundCandidates ?? []);
const fallbackBgAttr = fallbackCandidates.length > 1
  ? JSON.stringify(fallbackCandidates)
  : (fallbackCandidates[0] || fallbackImageUrl || undefined);

const bgMode = backgroundMeta?.mode || 'cover';
const bgCompression = Number(backgroundMeta?.compressionFactor ?? backgroundMeta?.compression ?? backgroundMeta?.bgCompression ?? backgroundMeta?.scale ?? 1);
const bgScale = Number(backgroundMeta?.size || 100);
const bgEffectiveScale = Number.isFinite(bgCompression) && bgCompression > 0 ? bgCompression : 1;

let bgImagePosition = 'center';
let bgImageSize = 'cover';
let bgImageRepeat = 'no-repeat';
switch (bgMode) {
  case 'contain':
    bgImageSize = 'contain';
    break;
  case 'fill':
    bgImageSize = '100% 100%';
    break;
  case 'tile':
    bgImagePosition = '0 0';
    bgImageSize = `${bgScale * bgEffectiveScale}%`;
    bgImageRepeat = 'repeat';
    break;
  case 'custom':
    bgImagePosition = `${backgroundMeta?.posX ?? 50}% ${backgroundMeta?.posY ?? 50}%`;
    bgImageSize = `${bgScale * bgEffectiveScale}%`;
    bgImageRepeat = 'no-repeat';
    break;
  case 'cover':
  default:
    bgImagePosition = 'center';
    bgImageSize = 'cover';
    bgImageRepeat = 'no-repeat';
}

const bgBlur = Number(backgroundMeta?.blur || 0);

function overlayRgba(color: any, opacity: any): string {
  const c = String(color || '').trim();
  if (!c || c === 'transparent') return 'transparent';
  const opa = (opacity != null ? (Number(opacity) || 0) : 0) / 100;
  const rgb = hexToRgbString(c);
  return `rgba(${rgb}, ${opa})`;
}

const bgOverlayLight = overlayRgba(
  backgroundMeta?.overlayLightColor || backgroundMeta?.overlayColor,
  backgroundMeta?.overlayLightOpacity != null ? backgroundMeta?.overlayLightOpacity : backgroundMeta?.overlayOpacity
);
const bgOverlayDark = overlayRgba(
  backgroundMeta?.overlayDarkColor || backgroundMeta?.overlayColor,
  backgroundMeta?.overlayDarkOpacity != null ? backgroundMeta?.overlayDarkOpacity : backgroundMeta?.overlayOpacity
);

const hasSurfaceLight = Boolean(backgroundColorLight);
const hasSurfaceDark = Boolean(backgroundColorDark);

// 遮罩/模糊属于「背景层」而非「图片」——有图或有视频都应生效，否则纯视频背景
// 会漏掉 background.yml 里配置的 overlay + blur。
const hasBackgroundMedia = Boolean(fallbackImageUrl || backgroundVideoUrl);

let backgroundCss = '';
if (fallbackImageUrl) {
  // NOTE: background-image URL is intentionally NOT inlined here. A CSS
  // background-image starts downloading the moment the style is parsed, i.e.
  // at +0ms on the critical path — measured +13.6x FCP (260ms→3552ms) on a
  // 188KB bg under contended bandwidth. The URL lives only in data-bg-image
  // and is applied by JS (layout-init.ts) AFTER first paint, same as the video.
  backgroundCss += '#chr-bg-layer .bg-image {\n';
  backgroundCss += `  background-size: ${bgImageSize} !important;\n`;
  backgroundCss += `  background-position: ${bgImagePosition} !important;\n`;
  backgroundCss += `  background-repeat: ${bgImageRepeat} !important;\n`;
  backgroundCss += '}\n';
}
if (hasBackgroundMedia) {
  if (bgBlur > 0) {
    backgroundCss += '#chr-bg-layer .bg-overlay {\n';
    backgroundCss += `  backdrop-filter: blur(${bgBlur}px);\n`;
    backgroundCss += `  -webkit-backdrop-filter: blur(${bgBlur}px);\n`;
    backgroundCss += '}\n';
  }
  backgroundCss += ':root {\n';
  backgroundCss += `  --frontend-bg-overlay-light: ${bgOverlayLight};\n`;
  backgroundCss += `  --frontend-bg-overlay-dark: ${bgOverlayDark};\n`;
  backgroundCss += '}\n';
}
if (hasSurfaceLight || hasSurfaceDark) {
  if (hasSurfaceLight) backgroundCss += `:root { --bg-surface-color-light: ${backgroundColorLight}; }\n`;
  if (hasSurfaceDark) backgroundCss += `:root { --bg-surface-color-dark: ${backgroundColorDark}; }\n`;
  backgroundCss += ':root { --bg-surface-color: var(--bg-surface-color-dark, var(--app-bg-pri)); }\n';
  backgroundCss += ':root[data-theme="light"] { --bg-surface-color: var(--bg-surface-color-light, var(--app-bg-pri)); }\n';
  backgroundCss += '@media (prefers-color-scheme: light) { :root:not([data-theme="dark"]) { --bg-surface-color: var(--bg-surface-color-light, var(--app-bg-pri)); } }\n';
}

// 从Astro.locals获取locale（由middleware设置）
const locale = propLocale || getLocale(Astro.locals);
const htmlLang = locale === 'zh-CN' ? 'zh-CN' : 'en';
const t = (key: string) => getTranslation(locale, key);
const routePrefix = locale === 'zh-CN' ? '/zh' : '/en';
// ── Analytics (3.1.x) — multi-backend, from the site.yml analytics: block ──
const analyticsCfg = ((settings as Record<string, any>)?.analytics || {}) as Record<string, any>;
const analyticsEnabled = analyticsCfg.enabled === true;
const analyticsBackend = analyticsEnabled ? String(analyticsCfg.backend || '') : '';
const ANALYTICS_GA_ID = String(process.env.GA_MEASUREMENT_ID || analyticsCfg.gaMeasurementId || '').trim();
---
<!DOCTYPE html>
<html lang={htmlLang} class={"immersive"} data-perf-default={defaultPerformanceMode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {settings?.post?.postComments?.walineServerUrl ? <link rel="dns-prefetch" href={String(settings.post.postComments.walineServerUrl).replace(/\/+$/, '')} /> : null}
    <meta name="description" content={metaDescription} />
    {metaKeywords ? <meta name="keywords" content={metaKeywords} /> : null}
    {metaRobots ? <meta name="robots" content={metaRobots} /> : null}
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={metaType} />
    {metaUrl ? <meta property="og:url" content={metaUrl} /> : null}
    {metaImage ? <meta property="og:image" content={metaImage} /> : null}
    <meta name="twitter:card" content={metaImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={metaTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {metaImage ? <meta name="twitter:image" content={metaImage} /> : null}
    <title>{displayTitle}</title>
    <!-- Analytics injection (3.1.x multi-backend). All backends load after
         window.load (non-blocking) and fail silently when unreachable.
         Custom events (page_view / post_view) are only used by Google Analytics;
         Cloudflare RUM / Umami / Plausible / Baidu auto-track. -->
    {analyticsEnabled && analyticsBackend === 'ga' && ANALYTICS_GA_ID ? (
        <script is:inline define:vars={{ ANALYTICS_GA_ID }}>
          // 队列：gtag() 调用先入 dataLayer，gtag.js 真正加载后自动重放，不丢事件。
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          gtag('js', new Date());
          gtag('config', ANALYTICS_GA_ID, { send_page_view: false });

          // gtag.js 延迟注入：等 window.load 之后再加载，避免 googletagmanager.com
          // 被墙/超时时阻塞 load 事件。被墙时脚本 onerror 静默失败，不影响页面。
          (function injectGtag() {
            function load() {
              var s = document.createElement('script');
              s.async = true;
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(ANALYTICS_GA_ID);
              s.onerror = function () { /* 被墙/超时：静默失败 */ };
              document.head.appendChild(s);
            }
            if (document.readyState === 'complete') {
              setTimeout(load, 0);
            } else {
              window.addEventListener('load', function () { setTimeout(load, 0); }, { once: true });
            }
          })();
        </script>
        <script is:inline>
          (function(){
            if (typeof window === 'undefined') return;
            // __chronicleAnalytics shim — custom events only meaningful for GA.
            window.__chronicleAnalytics = {
              track: function (event, params) {
                if (typeof window.gtag === 'function') {
                  try { window.gtag('event', event, params || {}); } catch (e) {}
                }
              }
            };
            function sendPageView() {
              try {
                const settings = (window.__CHRONICLE_SETTINGS__ || {});
                const analytics = settings?.analytics || {};
                if (analytics.enabled !== true) return;
                window.__chronicleAnalytics.track('page_view', { page_path: location.pathname, page_title: document.title });
              } catch (e) { console.warn('[analytics] page_view failed', e); }
            }
            document.addEventListener('astro:page-load', sendPageView);
            document.addEventListener('astro:after-swap', sendPageView);
          })();
        </script>
    ) : analyticsEnabled && analyticsBackend === 'cloudflare' && analyticsCfg.cloudflareToken ? (
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={`{"token": "${analyticsCfg.cloudflareToken}"}`}></script>
    ) : analyticsEnabled && analyticsBackend === 'umami' && analyticsCfg.umamiServerUrl && analyticsCfg.umamiWebsiteId ? (
        <script defer src={`${analyticsCfg.umamiServerUrl}/script.js`} data-website-id={analyticsCfg.umamiWebsiteId}></script>
    ) : analyticsEnabled && analyticsBackend === 'plausible' && analyticsCfg.plausibleServerUrl && analyticsCfg.plausibleDomain ? (
        <script defer data-domain={analyticsCfg.plausibleDomain} src={`${analyticsCfg.plausibleServerUrl}/js/script.js`}></script>
    ) : analyticsEnabled && analyticsBackend === 'baidu' && analyticsCfg.baiduId ? (
        <script is:inline define:vars={{ BAIDU_ID: analyticsCfg.baiduId }}>
          var _hmt = _hmt || [];
          (function () {
            var hm = document.createElement('script');
            hm.src = 'https://hm.baidu.com/hm.js?' + BAIDU_ID;
            var s = document.getElementsByTagName('script')[0];
            s.parentNode.insertBefore(hm, s);
          })();
        </script>
    ) : null}

    <!-- Legacy SW cleanup (non-blocking) -->
    <script async>
      (function(){if(typeof window==='undefined'||!('serviceWorker' in navigator))return;
      const f='chronicle.sw.cleanup.v2';(async()=>{try{
      const r=await navigator.serviceWorker.getRegistrations();if(!r.length)return;
      await Promise.all(r.map(x=>x.unregister()));
      if('caches' in window){const k=await caches.keys();await Promise.all(k.map(x=>caches.delete(x)))}
      if(!sessionStorage.getItem(f)){sessionStorage.setItem(f,'1');location.reload()}
      }catch(e){}})()})();
    </script>

    <ClientRouter />

    <!-- 主题首帧初始化（FOUC 防护）：focus 清除 + 字体 + data-theme 首帧应用。
         必须早于任何依赖 data-theme 的 CSS（critical tokens 之前）。 -->
    <ThemeInit />

    <!-- Critical tokens: inlined to eliminate network RTT.
         Tokens must resolve before the skeleton CSS below paints. -->
    <style is:inline set:html={criticalTokens}></style>

    <!-- 主题 SSR 变量（accent / 字体栈 / 视图过渡辅助） -->
    <ThemeVars accent={accent} font={font} />

    <!-- Critical CSS skeleton (geometry + colours — tokens are inline above) -->
    <style is:inline set:html={criticalCSS}></style>

    <!-- Background layer CSS: image + mode + blur + overlay/surface colors resolved at build time -->
    {backgroundCss ? <style is:inline set:html={backgroundCss}></style> : null}

    <script define:vars={{ theme, accent, background, backgroundMeta, backgroundColorLight, backgroundColorDark, font, featureFlags, analyticsCfg }}>
      // 将settings传递给客户端
      window.__CHRONICLE_SETTINGS__ = {
        theme,
        accent,
        background,
        backgroundMeta,
        backgroundColorLight,
        backgroundColorDark,
        font,
        featureFlags,
        analytics: analyticsCfg
      };
    </script>

    <script define:vars={{ mediaBaseUrl: mediaDomain }}>
      window.__CHRONICLE_MEDIA_BASE_URL__ = mediaBaseUrl;
    </script>

    <!-- 主题运行时：移动端类 / 性能模式 / 背景层淡入 / 软路由主题恢复 -->
    <ThemeRuntime />

    <!-- Named slot: pages can inject head content (e.g. render-blocking stylesheets
         that must apply before first paint, like chronicle-markdown.css on post pages). -->
    <slot name="head" />
  </head>
  <body class="frontend-body">
    <!-- 全局隐藏的 SVG defs，放在 body 开头 -->
    <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden;pointer-events:none;">
      <defs>
        <!-- 线形小箭头：stroke-only, 更小尺寸 -->
        <marker id="chronicle-mermaid-arrow" markerWidth="6" markerHeight="6" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
          <path d="M0,0 L6,3 L0,6" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
        </marker>
        <!-- 如需不同样式，可再加 marker id -->
      </defs>
    </svg>
    <!-- 背景层 - 使用transition:persist保持跨页面持久化 -->
    <div id="chr-bg-layer" transition:persist="background-layer" data-bg-image={fallbackBgAttr}>
      <div class="bg-image"></div>
      <div class="bg-surface"></div>
      {backgroundVideoUrl ? (
        <video class="bg-video" muted loop={videoLoop} playsinline preload="none" src={backgroundVideoUrl} data-autoplay={videoAutoplay ? '1' : '0'} data-playback-rate={String(videoPlaybackRate)}></video>
      ) : null}
      <div class="bg-overlay"></div>
    </div>

    <div id="app">
      <NavHeader currentPath={Astro.url.pathname} locale={locale} articleTitle={navTitle} articleBackHref={navBackHref} articleBackLabel={navBackLabel} featureFlags={featureFlags} defaultPerformanceMode={defaultPerformanceMode} siteName={siteTitle} />

      {disableMainContentTransition ? (
        <div class={`main-content ${scrollable === false ? 'unscrollable' : ''}`}>
          <slot />
        </div>
      ) : (
        <div class={`main-content ${scrollable === false ? 'unscrollable' : ''}`} transition:animate="fade">
          <slot />
        </div>
      )}
    </div>

    <FilePreviewModal />

    {featureFlags.globalSearch === true ? <GlobalSearchOverlay locale={locale} routePrefix={routePrefix} t={t} searchSuggestionsEnabled={featureFlags.searchSuggestions !== false} fullTextSearchEnabled={featureFlags.fullTextSearch === true} /> : null}


    <!-- Deferred link prefetch: activates only after the page is idle.
         Kept out of the initial bundle to preserve FCP — Astro's built-in
         `prefetch` config injects ~4 KiB of prefetch.js into the critical
         JS chain; this tiny (~600 B) replacement uses event delegation and
         native fetch(), waking up only after requestIdleCallback / 2 s fallback.
         Subsequent SPA navigations benefit from pre-warmed pages. -->
    <script>
      (function () {
        const PREFETCHED = new Set();
        let _active = false;

        function resolveUrl(href: string) {
          try {
            const u = new URL(href, location.origin);
            if (u.origin !== location.origin) return '';
            if (u.hash && u.pathname + u.search === location.pathname + location.search) return '';
            return u.pathname + u.search;
          } catch { return ''; }
        }

        function prefetch(url: string) {
          if (PREFETCHED.has(url)) return;
          PREFETCHED.add(url);
          // priority: 'low' tells the browser this fetch must not compete with
          // critical resources on the current page — no timer needed.
          const controller = new AbortController();
          setTimeout(() => controller.abort(), 10000);
          fetch(url, { priority: 'low', signal: controller.signal, headers: { 'X-Prefetch': '1' } }).catch(() => {});
        }

        function onHover(e: Event) {
          const a = (e.target as Element).closest('a[href]') as HTMLAnchorElement | null;
          if (!a) return;
          const url = resolveUrl(a.href);
          if (url) prefetch(url);
        }

        function activate() {
          if (_active) return;
          _active = true;
          // mouseover + touchstart, no timer — priority: 'low' ensures this
          // never contends with current-page rendering
          document.addEventListener('mouseover', onHover, { passive: true });
          document.addEventListener('touchstart', onHover, { passive: true });
        }

        // Defer activation until the page is fully settled.
        document.addEventListener('astro:page-load', () => {
          if (_active) return;
          if (typeof requestIdleCallback !== 'undefined') {
            requestIdleCallback(() => activate(), { timeout: 2000 });
          } else {
            setTimeout(activate, 2000);
          }
        });
      })();
    </script>

    <!-- tocController is lazily loaded by FloatingToc.astro (article pages) and
         cornerButtonCore.ts (TOC templates only). Homepage never loads it. -->
  </body>
</html>