---
import { getPublishedPosts } from '../data/localDataSource';
import { getTranslation, type Locale } from '../utils/i18n';

interface Props { post: any; locale: Locale; lang: string }
const { post, locale, lang } = Astro.props as Props;
const t = (key: string) => getTranslation(locale, key);

const all = getPublishedPosts() as any[];
const others = all.filter((p: any) => String(p.id) !== String(post.id));
const myTags = new Set((post.tags || []).map((x: string) => String(x)));
const scored = others
  .map((p: any) => {
    let score = 0;
    for (const tag of p.tags || []) if (myTags.has(String(tag))) score += 2;
    if (p.collectionPath && post.collectionPath && p.collectionPath === post.collectionPath) score += 3;
    return { p, score };
  })
  .sort((a: any, b: any) => b.score - a.score || (String(a.p.date) < String(b.p.date) ? 1 : -1));
const strong = scored.filter((x: any) => x.score > 0).map((x: any) => x.p);
const fill = scored.filter((x: any) => x.score === 0).map((x: any) => x.p);
const related = [...strong, ...fill].slice(0, 3);
---

{related.length > 0 && (
  <section class="related-posts">
    <h2 class="related-title">{t('postPage.relatedPosts')}</h2>
    <div class="related-grid">
      {related.map((p: any) => (
        <a class="related-card mtl-surface interactive glowable scalable" href={`/${lang}/post/${encodeURIComponent(p.id)}`}>
          <span class="related-card-title">{p.title}</span>
          <span class="related-card-date">{new Date(p.date).toLocaleDateString(locale)}</span>
          {(p.tags || []).length > 0 && (
            <span class="related-card-tags">{(p.tags || []).slice(0, 3).join(' · ')}</span>
          )}
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-posts { margin-top: 0.25rem; }
  .related-title { font-size: 1.05rem; margin: 0 0 0.75rem; }
  .related-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .related-card { display: flex; flex-direction: column; gap: 0.3rem; padding: 0.85rem 1rem; border-radius: 10px; text-decoration: none; color: var(--comp-text-pri);
    transition: background-color 0.15s ease, transform 0.15s ease; }
  .related-card-title { font-size: 0.9rem; font-weight: 600; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .related-card-date { font-size: 0.75rem; opacity: 0.6; }
  .related-card-tags { font-size: 0.72rem; opacity: 0.55; }
  /* Mobile grid optimization (3.1.x) */
  @media (max-width: 900px) { .related-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .related-grid { grid-template-columns: 1fr; } }
</style>
