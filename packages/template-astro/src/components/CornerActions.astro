---
import BackToTop from './BackToTop.astro';
import CornerButton from './CornerButton.astro';
import CollectionNav from './CollectionNav.astro';
import type { TocItem } from '../utils/toc';
import { getTranslation, getLocale } from '../utils/i18n';

interface Props { toc?: TocItem[]; collections?: any[]; postTitles?: Record<string, string>; postTypes?: Record<string, string>; postId?: string; commentsEnabled?: boolean; collectionEnabled?: boolean }
const { toc=[], collections=[], postTitles={}, postTypes={}, postId='', commentsEnabled=true, collectionEnabled=true } = Astro.props as Props;

const locale = getLocale(Astro.locals);
const t = (key: string) => getTranslation(locale, key);

function inCol(n:any[]|undefined,pid:string):boolean{if(!Array.isArray(n))return false;for(const x of n){if(x?.type==='post'&&String(x.id)===pid)return true;if(x?.children&&inCol(x.children,pid))return true}return false}
const hasCol=collectionEnabled&&!!(postId&&collections.length)&&collections.some((c:any)=>inCol(c.nodes,postId));
const hasToc=toc.length>0, hasComment=commentsEnabled, btnCount=(hasToc?1:0)+(hasCol?1:0)+(hasComment?1:0), capW=btnCount*50+(btnCount-1);
---

<BackToTop />

<div class="ca-left">
  <CornerButton id="cb-left" template="menu" side="left" variant="primary" capsule={btnCount>1} capsuleWidth={capW}>
    <Fragment slot="buttons">
      {hasToc&&(<button class="cb__slot" data-menu="toc" title={t('inblog.toc-title')} aria-label={t('inblog.toc-title')}><svg class="cb__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg></button>)}
      {hasToc&&hasCol&&(<span class="cb__divider"></span>)}
      {hasCol&&(<button class="cb__slot" data-menu="collection" title={t('nav.collection')} aria-label={t('nav.collection')}><svg class="cb__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M 12 2 L 21 8 L 12 14 L 3 8 Z"/><path d="M 18 14 L 21 16 L 12 22 L 3 16 L 6 14"/></svg></button>)}
      {(hasToc||hasCol)&&hasComment&&(<span class="cb__divider"></span>)}
      {hasComment&&(<button class="cb__slot" data-action="scrollToComment" title={t('comment.title')} aria-label={t('comment.title')}><svg class="cb__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></button>)}
    </Fragment>
    {hasToc&&(<ul data-menu="toc" class="cb__list" hidden>{toc.map((item:TocItem)=>(<li class:list={['cb__list-item',`cb__list-item--l${item.level}`]} data-toc-id={item.id}><a href={`#${item.id}`} class="cb__list-link" data-toc-id={item.id}><span class="cb__list-text">{item.text}</span></a></li>))}</ul>)}
    {hasCol&&(<div data-menu="collection" hidden><CollectionNav collections={collections} postTitles={postTitles} postTypes={postTypes} postId={postId} variant="inline" /></div>)}
  </CornerButton>
</div>

<style is:global>
  .ca-left{display:none}
  html.is-mobile .ca-left{display:block}
</style>
