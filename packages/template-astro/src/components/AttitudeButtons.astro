---
import { getTranslation, type Locale } from '../utils/i18n';

interface Props {
  postId: string;
  walineServerUrl: string;
  locale: Locale;
}
const { postId, walineServerUrl, locale } = Astro.props as Props;
const t = (key: string) => getTranslation(locale, key);
---

<div class="attitude" data-waline-server={walineServerUrl} data-post-id={postId} data-lang={locale}>
  <p class="attitude-prompt">{t('postPage.attitudePrompt')}</p>
  <div class="attitude-btns">
    <button type="button" class="attitude-btn" data-reaction="0" disabled aria-label={t('postPage.attitudeLike')}>
      <svg class="attitude-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <span class="attitude-count" data-count-for="0">0</span>
    </button>
    <button type="button" class="attitude-btn dislike" data-reaction="1" disabled aria-label={t('postPage.attitudeDislike')}>
      <svg class="attitude-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/><line x1="3" y1="21" x2="21" y2="3"/></svg>
      <span class="attitude-count" data-count-for="1">0</span>
    </button>
  </div>
</div>


<script is:inline>
  // Waline reaction (article reaction counts). Waline stores up to 9 emoji
  // reaction counts per path; here reaction0 = like, reaction1 = dislike.
  // Server API: Waline 计数端点 GET/POST /api/article（type: reaction0/reaction1, action: inc/desc）。
  // NOTE: is:inline script is output verbatim — keep this file plain JS (no TS annotations).
  (() => {
    const root = document.querySelector('.attitude');
    if (!root) return;
    const server = (root.dataset.walineServer || '').replace(/\/$/, '');
    if (!server) { root.remove(); return; }
    const lang = root.dataset.lang || 'zh-CN';
    const path = location.pathname;
    const storageKey = 'chronicle-attitude:' + path;
    const buttons = Array.from(root.querySelectorAll('.attitude-btn'));
    const countEls = Array.from(root.querySelectorAll('[data-count-for]'));

    function setCount(i, n) {
      countEls.forEach((el) => { if (el.dataset.countFor === String(i)) el.textContent = String(n); });
    }
    function lockVote(i) {
      buttons.forEach((b, idx) => { b.classList.toggle('voted', idx === i); b.disabled = true; });
      try { localStorage.setItem(storageKey, String(i)); } catch (e) {}
    }

    function init() {
      // 1. Load counts — Waline 计数 API：GET /api/article?path=&type=reaction0,reaction1&lang=
      fetch(server + '/api/article?path=' + encodeURIComponent(path) + '&type=reaction0,reaction1&lang=' + encodeURIComponent(lang), { headers: { Accept: 'application/json' } })
        .then((r) => (r.ok ? r.json() : null))
        .then((json) => {
          // Waline 计数返回 { errno: 0, data: [{reaction0, reaction1}] }（数组按 path 顺序）
          const d = Array.isArray(json && json.data) ? (json.data[0] || {}) : (json && json.data) || json;
          const c0 = Number(d.reaction0 || 0);
          const c1 = Number(d.reaction1 || 0);
          setCount(0, c0); setCount(1, c1);
          buttons.forEach((b) => { b.disabled = false; });
          // Re-apply a previous vote for this path (local-only).
          try {
            const v = localStorage.getItem(storageKey);
            if (v !== null) lockVote(Number(v));
          } catch (e) {}
        })
        .catch(() => {
          // Server unreachable / shape mismatch — keep the widget but non-interactive.
          buttons.forEach((b) => { b.disabled = true; });
        });

      // 2. Submit vote
      root.addEventListener('click', (e) => {
        const btn = (e.target).closest && (e.target).closest('.attitude-btn');
        if (!btn || btn.disabled) return;
        const i = Number(btn.dataset.reaction);
        btn.disabled = true;
        fetch(server + '/api/article?lang=' + encodeURIComponent(lang), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ path: path, type: 'reaction' + i, action: 'inc' }),
        })
          .then((r) => (r.ok ? r.json() : null))
          .then(() => {
            const cur = Number(countEls[i] && countEls[i].textContent || 0);
            setCount(i, cur + 1);
            lockVote(i);
          })
          .catch(() => { btn.disabled = false; });
      });
    }

    // 进视口才初始化（Waline 请求按需触发，避免页面加载即拉取）
    if ('IntersectionObserver' in window) {
      // rootMargin 下方提前 300px：用户滚向态度区时预取计数，滚到时数据已就绪
      const io = new IntersectionObserver((entries, obs) => {
        if (entries.some((e) => e.isIntersecting)) { obs.disconnect(); init(); }
      }, { rootMargin: '0px 0px 300px 0px' });
      io.observe(root);
    } else {
      init();
    }
  })();
</script>

<style>
  /* share-btn 同款：大 SVG 图标在上、较淡小字计数在下、透明背景 hover 高亮 */
  .attitude { display: flex; flex-direction: column; align-items: center; gap: 1rem; margin: 2rem 0; }
  .attitude-prompt { margin: 0; font-size: 1rem; opacity: 0.72; }
  .attitude-btns { display: flex; gap: 1.5rem; }
  .attitude-btn { display: inline-flex; flex-direction: column; align-items: center; gap: 0.5rem;
    padding: 0.5rem 0.9rem; border-radius: 8px; border: none; background: transparent;
    color: var(--app-text-sec); cursor: pointer; transition: background 0.15s ease, color 0.15s ease, opacity 0.15s ease; }
  .attitude-btn:hover:not(:disabled) { background: var(--hover); color: var(--app-text-pri); }
  .attitude-btn.voted { color: var(--accent); opacity: 1 !important; }
  .attitude-btn.voted.dislike { color: var(--bg-offset); }
  .attitude-btn.voted .attitude-icon { fill: currentColor; }
  .attitude-btn:disabled { opacity: 0.55; cursor: default; }
  .attitude-icon { width: 36px; height: 36px; }
  .attitude-count { font-size: 0.85rem; opacity: 0.6; font-variant-numeric: tabular-nums; }
</style>