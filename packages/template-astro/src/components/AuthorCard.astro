---
import { getProfile, getPublicSettings } from '../data/localDataSource';
import ChronicleImage from './ChronicleImage.astro';
import { getTranslation, type Locale } from '../utils/i18n';
import { isSiteAuthor } from '@chronicle/shared/src/utils';

interface Props { locale: Locale; post?: any }
const { locale, post } = Astro.props as Props;
const t = (key: string) => getTranslation(locale, key);
const profile = getProfile() as Record<string, any>;

// 作者卡片只展示网站作者本人：唯一作者 且 是本人（占位符 $site$ 或与 profile.name 匹配）
// 多作者（含其他作者）或空 author 一律不显示
const authorList = Array.isArray(post?.authors) && post.authors.length > 0
  ? post.authors
  : (post?.author ? [post.author] : []);
const showAuthorCard = authorList.length === 1 && isSiteAuthor(authorList[0], profile?.name);
// 关于页跳转：aboutPage 开关关（site.yml aboutPage: false）则不显示
const aboutEnabled = (getPublicSettings() as Record<string, any>)?.aboutPage !== false;
const lang = locale === 'zh-CN' ? 'zh' : 'en';
---

{showAuthorCard && (
<section class="author-card">
  {profile.avatar && (
  <ChronicleImage src={profile.avatar} alt={profile.name || 'author'} class="author-avatar u-clickable" loading="lazy" decoding="async" onclick="window.__openFilePreview?.({ url: event.target.src, title: event.target.alt, type: 'image' })" />
)}
  <div class="author-body">
    <h3 class="author-name">{profile.name || t('inblog.anonymousAuthor')}</h3>
    {profile.bio && <p class="author-bio">{profile.bio}</p>}
    {aboutEnabled && <a href={`/${lang}/about`} class="author-link">{t('inblog.aboutMe')}</a>}
    {Array.isArray(profile.links) && profile.links.length > 0 && (
      <div class="author-links">
        {profile.links.map((l: any) => (
          <a href={String(l.url || '#')} target="_blank" rel="noopener noreferrer" class="author-link">{l.label || l.url}</a>
        ))}
      </div>
    )}
  </div>
</section>
)}

<style>
  .author-card { display: flex; gap: 1rem; align-items: flex-start; padding: 1rem 1.25rem; border-radius: 12px;
    border: 1px solid var(--border-color); background: var(--comp-bg-blur); }
  .author-avatar { width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .author-body { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  .author-name { margin: 0; font-size: 1rem; }
  .author-bio { margin: 0; font-size: 0.85rem; opacity: 0.75; line-height: 1.5; }
  .author-links { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .author-link { font-size: 0.8rem; color: var(--accent); text-decoration: none; }
  .author-link:hover { text-decoration: underline; }
</style>
