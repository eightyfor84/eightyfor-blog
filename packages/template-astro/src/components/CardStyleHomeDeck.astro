---
import { buildLocalizedPath } from "../utils/routeLocale";
import { loadSiteSettings } from "../utils/siteSettings";
import { loadSiteProfile } from "../utils/siteProfile";
import { getTranslation, getLocale } from "../utils/i18n";
import SearchBox from "./SearchBox.astro";
import ChronicleImage from "./ChronicleImage.astro";

const { locale, featureFlags } = Astro.props || {
  locale: "zh-CN",
  featureFlags: {},
};
const t = (key: string) => getTranslation(locale, key);
const routeLang = locale;
const blogsPath = buildLocalizedPath(locale, "/blogs");
const friendsPath = buildLocalizedPath(locale, "/friends");
const aboutPath = buildLocalizedPath(locale, "/about");
const collectionPath = buildLocalizedPath(locale, "/collection");
const searchPath = buildLocalizedPath(locale, "/search");
const settings = await loadSiteSettings();
const profile = await loadSiteProfile();

const siteTitle = settings?.siteName || "Chronicle";
const authorName =
  profile?.name ||
  settings?.authorName ||
  (t("home.defaultAuthorName") as string);
const authorBio = profile?.bio || "";
const authorAvatar = profile?.avatar || "";
const authorAvatarSourceRaw = profile?.avatarSource || "";
const authorAvatarSource =
  authorAvatarSourceRaw &&
  !authorAvatarSourceRaw.startsWith("/") &&
  !authorAvatarSourceRaw.startsWith("http")
    ? `/assets/${authorAvatarSourceRaw}`
    : authorAvatarSourceRaw || authorAvatar;
const cardSubtitle =
  settings?.siteDescription || (t("home.cardSubtitle") as string);
const cardAuthorLine = t("home.cardAuthorLine") as string;
const isFriendsEnabled = featureFlags?.friendsPage !== false;
const isCollectionEnabled = featureFlags?.collectionPage !== false;

// Icon glyphs (Lucide-style, stroke=currentColor) for the activity-card items.
// Each type's colour is applied via `.activity-item__icon { color }`, so the
// stroke inherits it through `currentColor`.
const activityIcons = {
  date: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
  app: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
  post: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>',
  collection:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M 12 2 L 21 8 L 12 14 L 3 8 Z"/><path d="M 18 14 L 21 16 L 12 22 L 3 16 L 6 14"/></svg>',
  stale:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  delete:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>',
};

// Home footer site links (profile links + RSS + About). Separators are rendered
// only *between* items, so disabling any item never leaves a dangling "·".
type FooterLink = {
  label: string;
  href: string;
  attrs: Record<string, string>;
};
const footerLinks: FooterLink[] = [
  ...profile.links.map((l) => ({
    label: l.label,
    href: l.url,
    attrs: { target: "_blank", rel: "noopener noreferrer" },
  })),
  ...(featureFlags?.rss !== false
    ? [
        {
          label: t("home.rssSubscribe") as string,
          href: "/rss.xml",
          attrs: {
            rel: "alternate nofollow",
            type: "application/rss+xml",
            target: "_blank",
            title: t("home.rssSubscribe") as string,
          },
        },
      ]
    : []),
  ...(featureFlags?.aboutPage !== false
    ? [{ label: t("nav.about") as string, href: aboutPath, attrs: {} }]
    : []),
];

// Homepage card visibility
const cv = settings?.cardVisibility || {};
const showAuthorCard = cv?.author !== false;
const showTaxonomyCard = cv?.taxonomy !== false;
const showActivityCard = cv?.activity !== false;
const isSingleColumn = settings?.singleColumnHomepage === true;

// Right column is empty if all cards in it are hidden
const rightColumnEmpty =
  !showAuthorCard && !showTaxonomyCard && !showActivityCard;

function interpolate(
  template: string,
  values: Record<string, string | number>,
) {
  return template.replace(/\{(\w+)\}/g, (_, key) => String(values[key] ?? ""));
}

function toPlainText(input: unknown) {
  return String(input || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, '"')
    .replace(/&#39;/gi, "'")
    .replace(/\s+/g, " ")
    .trim();
}

function pickSummary(post: any) {
  const raw =
    post?.summary ||
    post?.excerpt ||
    post?.description ||
    post?.content ||
    post?.html ||
    "";
  const text = toPlainText(raw);
  if (!text) return t("home.noSummary") as string;
  return text.slice(0, 140) + (text.length > 140 ? "…" : "");
}

function normalizeTag(tag: unknown) {
  return String(tag || "")
    .trim()
    .replace(/^#+/, "")
    .toLowerCase();
}

function isFeaturedTag(tag: unknown) {
  const normalized = normalizeTag(tag);
  return normalized === "featured" || normalized === "精选";
}

function canonicalTag(tag: unknown) {
  return isFeaturedTag(tag) ? "featured" : normalizeTag(tag);
}

function safeDateValue(value: unknown) {
  const date = new Date(String(value || ""));
  return Number.isNaN(date.getTime()) ? new Date(0) : date;
}

function formatDate(date: Date, options: Intl.DateTimeFormatOptions = {}) {
  return date.toLocaleDateString(locale, {
    year: "numeric",
    month: "short",
    day: "numeric",
    ...options,
  });
}

function buildPostUrl(postId: string) {
  return buildLocalizedPath(routeLang, `/post/${encodeURIComponent(postId)}`);
}

function uniqueById(list: any[]) {
  const seen = new Set<string>();
  return list.filter((item) => {
    const id = String(item?.id || "").trim();
    if (!id || seen.has(id)) return false;
    seen.add(id);
    return true;
  });
}

function buildTagStats(postsList: any[]) {
  const counts = new Map<string, number>();
  for (const post of postsList) {
    for (const tag of Array.isArray(post?.tags) ? post.tags : []) {
      const normalized = String(tag || "").trim();
      if (!normalized) continue;
      counts.set(normalized, (counts.get(normalized) || 0) + 1);
    }
  }
  return Array.from(counts.entries())
    .map(([name, count]) => ({
      name,
      count,
      featured: isFeaturedTag(name),
    }))
    .sort((a, b) => {
      if (a.featured && !b.featured) return -1;
      if (!a.featured && b.featured) return 1;
      if (b.count !== a.count) return b.count - a.count;
      return a.name.localeCompare(b.name);
    });
}

function buildArchiveStats(postsList: any[]) {
  const years = new Map<
    number,
    { count: number; months: Map<number, number>; latest: Date }
  >();
  for (const post of postsList) {
    const date = safeDateValue(post?.date);
    const year = date.getFullYear();
    const month = date.getMonth();
    const current = years.get(year) || {
      count: 0,
      months: new Map<number, number>(),
      latest: date,
    };
    current.count += 1;
    current.latest = current.latest > date ? current.latest : date;
    current.months.set(month, (current.months.get(month) || 0) + 1);
    years.set(year, current);
  }

  return Array.from(years.entries())
    .map(([year, data]) => ({
      year,
      count: data.count,
      latest: data.latest,
      months: Array.from(data.months.entries())
        .sort((a, b) => b[1] - a[1] || b[0] - a[0])
        .slice(0, 4)
        .map(([month, count]) => ({ month, count })),
    }))
    .sort((a, b) => b.year - a.year)
    .slice(0, 5);
}

function buildCollectionSummaries(collectionsList: any[]) {
  return collectionsList
    .filter(Boolean)
    .map((collection) => {
      const nodes = Array.isArray(collection.nodes) ? collection.nodes : [];
      const stats = { posts: 0, groups: 0 };
      const walk = (items: any[]) => {
        if (!Array.isArray(items)) return;
        for (const node of items) {
          if (!node) continue;
          if (node.type === "post" && node.id) stats.posts += 1;
          if (node.type === "group") {
            stats.groups += 1;
            walk(node.children);
          }
        }
      };
      walk(nodes);
      return {
        name:
          String(collection.name || "").trim() ||
          (t("home.unnamedCollection") as string),
        description: String(collection.description || "").trim(),
        posts: stats.posts,
        groups: stats.groups,
      };
    })
    .filter((item) => item.name)
    .sort((a, b) => b.posts - a.posts || b.groups - a.groups);
}

let posts: any[] = [];
let collections: any[] = [];

// Local/filesystem mode: read directly from data/ (single source of truth)
try {
  const { getPublishedPosts, getCollections } =
    await import("../data/localDataSource");
  posts = getPublishedPosts().map((p: any) => ({
    ...p,
    content: undefined,
    compiledHtml: undefined,
  }));
  collections = (getCollections() as any) || [];
  // unwrap legacy collection format
  if (
    !Array.isArray(collections) &&
    Array.isArray((collections as any).collections)
  ) {
    collections = (collections as any).collections;
  }
  if (!Array.isArray(collections)) collections = [];
} catch (e) {
  console.warn(
    "[CardStyleHomeDeck] localDataSource fallback failed, posts empty",
  );
}

const sortedPosts = [...posts].sort(
  (a, b) => safeDateValue(b?.date).getTime() - safeDateValue(a?.date).getTime(),
);
const featuredPosts = sortedPosts
  .filter((post) => Array.isArray(post?.tags) && post.tags.some(isFeaturedTag))
  .slice(0, 5);
const recentPosts = sortedPosts.slice(0, 10);
const leadPost = recentPosts[0] || featuredPosts[0] || null;
const secondaryPosts = uniqueById([...featuredPosts, ...recentPosts])
  .filter((post) => post?.id && post?.id !== leadPost?.id)
  .slice(0, 4);
const TAG_LIMIT = 14;
const COLLECTION_LIMIT = 3;
const allTagStats = buildTagStats(sortedPosts);
const tagStats = allTagStats
  .filter((item) => !item.featured)
  .slice(0, TAG_LIMIT);
const hasMoreTags =
  allTagStats.filter((item) => !item.featured).length > TAG_LIMIT;
const featuredTagStats = allTagStats
  .filter((item) => item.featured)
  .slice(0, 1);
const archiveStats = buildArchiveStats(sortedPosts);
const allCollectionSummaries = buildCollectionSummaries(collections);
const collectionSummaries = allCollectionSummaries.slice(0, COLLECTION_LIMIT);
const hasMoreCollections = allCollectionSummaries.length > COLLECTION_LIMIT;

const recommendedPosts = uniqueById([...featuredPosts, ...recentPosts])
  .filter((post) => post?.id && post?.id !== leadPost?.id)
  .slice(0, 3);

// Recent updates (git-based) with a static fallback (recent posts + collections,
// no friends). Fallback shares the exact same rendering — only the data differs:
// the "last updated" label reads "Unknown" and the content list is static.
type RecentUpdatesData = {
  latestCommitDate: string;
  appUpdated: boolean;
  changedPosts: { id: string; title: string; isNew: boolean }[];
  deletedCount: number;
  newCollections: { slug: string; name: string }[];
};
type ActivityItem = {
  tone: "app" | "post" | "collection" | "delete";
  label?: string;
  title: string;
  href?: string;
  external?: boolean;
};
// Clamp settings-sourced day counts to safe positive integers — a 0/negative/
// non-numeric value in site.yml must not silently empty the window or flip the
// stale flag permanently.
function sanitizeDays(value: unknown, fallback: number): number {
  const n = Number(value);
  return Number.isFinite(n) && n >= 1 ? Math.floor(n) : fallback;
}
const staleDays = sanitizeDays(settings?.recentUpdates?.staleDays, 30);
const aggregateDays = sanitizeDays(settings?.recentUpdates?.aggregateDays, 7);
// Fixed changelog target for the "App updated" activity item.
const appChangelogUrl =
  "https://github.com/vanvanhasnophi/chronicle-aurora/commits/main/";

let recentUpdates: RecentUpdatesData | null = null;
try {
  const { getRecentUpdates } = await import("../utils/recentUpdates");
  recentUpdates = await getRecentUpdates({
    posts,
    collections,
    aggregateDays,
  });
} catch {
  recentUpdates = null;
}

const updateTimeLabel = recentUpdates
  ? formatDate(safeDateValue(recentUpdates.latestCommitDate))
  : (t("home.unknownTime") as string);
const isStale = 
  !!recentUpdates &&
  Date.now() - safeDateValue(recentUpdates.latestCommitDate).getTime() >
    staleDays * 86400000;

// Unified content list — same shape for the git-derived (fresh) and the static
// fallback feed, so the markup renders identically in both cases.
const activityItems: ActivityItem[] = [];
if (recentUpdates) {
  if (recentUpdates.appUpdated) {
    activityItems.push({
      tone: "app",
      title: t("home.updatedApp") as string,
      href: appChangelogUrl,
      external: true,
    });
  }
  for (const p of recentUpdates.changedPosts) {
    activityItems.push({
      tone: "post",
      label: (p.isNew ? t("home.newPost") : t("home.updatedPost")) as string,
      title: p.title,
      href: buildPostUrl(p.id),
    });
  }
  if (recentUpdates.deletedCount > 0) {
    activityItems.push({
      tone: "delete",
      title: interpolate(t("home.deletedPosts") as string, {
        count: recentUpdates.deletedCount,
      }),
    });
  }
  for (const c of recentUpdates.newCollections) {
    activityItems.push({
      tone: "collection",
      label: t("home.newCollections") as string,
      title: c.name,
      href: collectionPath + "#" + encodeURIComponent(c.name),
    });
  }
} else {
  for (const post of recentPosts.slice(0, 3)) {
    activityItems.push({
      tone: "post",
      label: t("home.recentPublished") as string,
      title: post.title,
      href: buildPostUrl(post.id),
    });
  }
  if (isCollectionEnabled) {
    for (const collection of collectionSummaries.slice(0, 2)) {
      activityItems.push({
        tone: "collection",
        label: interpolate(t("home.collectionMeta"), {
          posts: collection.posts,
          groups: collection.groups,
        }),
        title: collection.name,
        href: collectionPath + "#" + encodeURIComponent(collection.name),
      });
    }
  }
}

const authorInitials =
  authorName
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((item: string) => item[0])
    .join("") || "C";

const yearLabel = new Date().getFullYear();
---

<section class="home-shell">
  <div
    class="card-flows"
    class:list={[{ "single-col": isSingleColumn || rightColumnEmpty }]}
  >
    <main class="flow-column flow-column--left">
      <article class="panel-card mtl-container flow-intro">
        <h1>{siteTitle}</h1>
        <p class="hero-description">{cardSubtitle}</p>

        <div class="hero-actions">
          <a
            class="float-btn primary"
            href={leadPost ? buildPostUrl(leadPost.id) : blogsPath}
          >
            {t("home.readingLatest")}
          </a>
          <a class="float-btn" href={blogsPath}>
            {t("home.browseAllPosts")}
          </a>
        </div>
      </article>

      <section class="panel-card mtl-container content-panel">
        <div class="section-head">
          <div>
            <h2 class="panel-kicker">{t("home.latestFeaturedArticles")}</h2>
            <h3>{t("home.mainContentStream")}</h3>
          </div>
          <a href={blogsPath}>{t("home.viewAll")}</a>
        </div>

        <div class="recent-stream">
          {
            recentPosts.length ? (
              recentPosts.map((post) => (
                <a href={buildPostUrl(post.id)} class="stream-card-link">
                  <article class="stream-card mtl-surface interactive glowable scalable">
                    <div class="stream-card__date">
                      {formatDate(safeDateValue(post.date))}
                    </div>
                    <div class="stream-card__body">
                      <div class="stream-card__top">
                        <h4>{post.title}</h4>
                        {Array.isArray(post.tags) &&
                        post.tags.some(isFeaturedTag) ? (
                          <span class="stream-card__flag featured">
                            {t("blog.featured")}
                          </span>
                        ) : null}
                      </div>
                      <p>{pickSummary(post)}</p>
                      <div class="stream-card__tags">
                        {Array.isArray(post.tags) &&
                          post.tags
                            .slice(0, 3)
                            .map((tag: string) => (
                              <span
                                class:list={[
                                  "tag",
                                  canonicalTag(tag) === "featured" &&
                                    "featured",
                                ]}
                              >
                                # {tag}
                              </span>
                            ))}
                      </div>
                    </div>
                  </article>
                </a>
              ))
            ) : (
              <div class="empty-state">{t("home.noPostsAvailable")}</div>
            )
          }
        </div>
      </section>
    </main>

    <aside
      class="flow-column flow-column--right"
      class:list={[{ "column-empty": rightColumnEmpty }]}
    >
      {
        showAuthorCard && (
          <article class="author-card panel-card mtl-container">
            <div class="author-card__top">
              {authorAvatar ? (
                <ChronicleImage
                  src={authorAvatar}
                  alt={authorName}
                  class="author-avatar u-zoomable"
                  width="64"
                  height="64"
                  loading="eager"
                  decoding="async"
                  fetchpriority="auto"
                  data-source={authorAvatarSource}
                  onclick="window.__openFilePreview?.({ url: event.target.dataset.source || event.target.src, title: event.target.alt, type: 'image' })"
                />
              ) : (
                <div class="author-avatar" aria-hidden="true">
                  {authorInitials}
                </div>
              )}
              <div>
                <h2 class="panel-kicker">{t("home.authorInfo")}</h2>
                <h3>{authorName}</h3>
              </div>
            </div>
            {authorBio ? (
              <p class="author-bio">{authorBio}</p>
            ) : (
              <p class="u-mb-0">{cardAuthorLine}</p>
            )}
          </article>
        )
      }

      {
        showTaxonomyCard && (
          <section class="panel-card mtl-container taxonomy-card">
            <div class="section-head flush">
              <div>
                <h2 class="panel-kicker">{t("home.topicNavigation")}</h2>
              </div>
            </div>

            <div class="taxonomy-block">
              <h3>{t("home.quickSearch")}</h3>
              <SearchBox
                instanceId="home-searchbox"
                searchSuggestionsEnabled={false}
                showTagTrigger={false}
                placeholder={t("search.placeholder")}
                featuredLabel={t("tag.featured")}
                searchOnEnter={true}
                t={t}
              />
            </div>

            {isCollectionEnabled && (
              <div class="taxonomy-block">
                <h3>{t("home.collectionList")}</h3>
                <div class="taxonomy-list">
                  {collectionSummaries.length
                    ? collectionSummaries.map((collection) => (
                        <a
                          class="mtl-surface interactive glowable scalable"
                          href={
                            collectionPath +
                            "#" +
                            encodeURIComponent(collection.name)
                          }
                        >
                          <span>{collection.name}</span>
                          <strong>{collection.posts}</strong>
                        </a>
                      ))
                    : null}
                </div>
                {hasMoreCollections ? (
                  <a href={collectionPath} class="view-more-link">
                    {t("home.viewAll")} →
                  </a>
                ) : null}
              </div>
            )}

            <div class="taxonomy-block">
              <h3>{t("home.tagCloud")}</h3>
              <div class="tag-cloud">
                {tagStats.map((tag) => (
                  <a
                    class:list={[
                      "tag-cloud-item",
                      tag.featured ? "featured" : "",
                    ]}
                    href={searchPath + "?tags=" + encodeURIComponent(tag.name)}
                  >
                    {tag.featured ? t("blog.featured") : tag.name}
                    <span class="tag-count">{tag.count}</span>
                  </a>
                ))}
              </div>
              {hasMoreTags ? (
                <a href={searchPath + "?view=tags"} class="view-more-link">
                  {t("home.viewAllTags")} →
                </a>
              ) : null}
            </div>
          </section>
        )
      }

      {
        showActivityCard && (
          <section class="panel-card mtl-container activity-card">
            <div class="section-head flush">
              <div>
                <h2 class="panel-kicker">{t("home.recentUpdates")}</h2>
              </div>
            </div>
            <div class="taxonomy-block">
              <h3>{t("home.updateTime")}</h3>
              <div class="activity-item date mtl-surface">
                <span
                  class="activity-item__icon"
                  aria-hidden="true"
                  set:html={activityIcons.date}
                />
                <span class="activity-item__text">
                  <strong>{updateTimeLabel}</strong>
                </span>
              </div>
            </div>
            {isStale && (
              <div class="activity-item stale">
                <span
                  class="activity-item__icon"
                  aria-hidden="true"
                  set:html={activityIcons.stale}
                />
                <span class="activity-item__text">
                  <strong>{t("home.staleNotice")}</strong>
                </span>
              </div>
            )}
              <div class="taxonomy-block">
                <h3>{t("home.updateContent")}</h3>
                <div class="activity-list">
                  {activityItems.length ? (
                    activityItems.map((item) =>
                      item.href ? (
                        <a
                          class:list={[
                            "activity-item",
                            item.tone,
                            "mtl-surface interactive glowable scalable",
                          ]}
                          href={item.href}
                          target={item.external ? "_blank" : undefined}
                          rel={item.external ? "noopener noreferrer" : undefined}
                        >
                          <span
                            class="activity-item__icon"
                            aria-hidden="true"
                            set:html={activityIcons[item.tone]}
                          />
                          <span class="activity-item__text">
                            {item.label ? (
                              <span class="activity-item__label">
                                {item.label}
                              </span>
                            ) : null}
                            <strong>{item.title}</strong>
                          </span>
                        </a>
                      ) : (
                        <div class:list={["activity-item", item.tone, "mtl-surface"]}>
                          <span
                            class="activity-item__icon"
                            aria-hidden="true"
                            set:html={activityIcons[item.tone]}
                          />
                          <span class="activity-item__text">
                            {item.label ? (
                              <span class="activity-item__label">
                                {item.label}
                              </span>
                            ) : null}
                            <strong>{item.title}</strong>
                          </span>
                        </div>
                      )
                    )
                  ) : (
                    <div class="empty-state">{t("home.noRecentChanges")}</div>
                  )}
                </div>
              </div>
            
          </section>
        )
      }
    </aside>
  </div>

  <footer class="panel-card mtl-container home-footer">
    <div class="home-footer__links">
      <nav class="home-footer__nav" aria-label={t("home.siteLinksAria")}>
        {
