<script define:vars={{ searchPath }}>
  let _homeSearchInit = false;

  function initHomeSearchBox() {
    const homeSearchBoxRoot = document.querySelector(
      '[data-searchbox-id="home-searchbox"]',
    );
    if (!homeSearchBoxRoot || _homeSearchInit) return;
    _homeSearchInit = true;

    homeSearchBoxRoot.addEventListener("searchbox:submit", (event) => {
      const detail = event.detail || {};
      const keyword = String(detail.query || "").trim();
      const target = keyword
        ? `${searchPath}?keyword=${encodeURIComponent(keyword)}`
        : `${searchPath}`;

      window.location.href = target;
    });
  }

  initHomeSearchBox();
  document.addEventListener("astro:page-load", initHomeSearchBox);
  document.addEventListener("astro:before-swap", () => {
    _homeSearchInit = false;
  });
</script>

