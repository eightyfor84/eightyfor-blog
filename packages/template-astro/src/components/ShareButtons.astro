---
interface Props {
  post: any;
  locale: string;
  lang: string;
  channels?: string[];
}
const { post, locale, lang, channels = ['twitter', 'weibo', 'copy-link'] } = Astro.props as Props;
const postUrl = `/${lang}/post/${encodeURIComponent(post?.id || '')}`;
const postTitle = String(post?.title || '');
---
{channels.length > 0 && (
  <div class="share-buttons">
    {channels.includes('twitter') && (
      <button type="button" class="share-btn" data-share="twitter" data-url={postUrl} data-title={postTitle}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span>Twitter / X</span>
      </button>
    )}
    {channels.includes('weibo') && (
      <button type="button" class="share-btn" data-share="weibo" data-url={postUrl} data-title={postTitle}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M10.9 20.1c-3.9.4-7.4-1.9-7.4-4.9 0-3 3.5-5.8 7.4-5.4 3.9.3 6.9 3 6.9 5.8 0 3-3.4 5-6.9 4.5zm8.3-8.8c.2-.4.1-1.2-.2-1.7l-.2.4c-.3.5-.6 1-.6 1.5-.2.4.6.7 1 .5l0-.2z"/><path d="M19.2 8.6c-1.9-3-5.8-4.6-9.3-3.6C7.3 5.8 4.9 8 4.2 10.5c1.4-.5 2.9-.6 4.3-.4 2.6.4 4.7 1.9 5.7 4 .3.6.5 1.2.6 1.8-.5.2-1 .3-1.5.3.1 1.6 1.5 3 3 2.9-2.1 1.3-4.9 1.7-7.3 1-1.9-.5-3.5-1.6-4.6-3-.3 1.4.1 3 .9 4.3 1.6 2.4 4.1 3.8 6.8 4 2.9.3 5.9-1 7.7-3.5 1.7-2.4 1.8-5.5.7-8.3-.3-.7-.6-1.4-1-2zm-3.5-4.2c1.5.5 2.7 1.5 3.5 2.7-.3-.9-.7-1.7-1.3-2.4-.7-.8-1.5-1.5-2.5-1.9-.9-.4-1.8-.6-2.8-.6-.4 0-.8 0-1.1.1.9 1 2 1.6 4.2 2.1z"/></svg>
        <span>微博</span>
      </button>
    )}
    {channels.includes('copy-link') && (
      <button type="button" class="share-btn" data-share="copy" data-url={postUrl}>
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
        <span>复制链接</span>
      </button>
    )}
  </div>
)}

<script is:inline>
  (() => {
    const base = location.origin;
    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest?.('.share-btn') as HTMLElement | null;
      if (!btn) return;
      const kind = btn.dataset.share;
      const rel = btn.dataset.url || '';
      const title = btn.dataset.title || document.title;
      const abs = rel.startsWith('http') ? rel : base + (rel.startsWith('/') ? rel : '/' + rel);
      if (kind === 'twitter') {
        window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'weibo') {
        window.open('https://service.weibo.com/share/share.php?title=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'copy') {
        const done = () => {
          const old = btn.textContent;
          btn.textContent = '已复制 ✓';
          setTimeout(() => { btn.textContent = old; }, 1500);
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(abs).then(done).catch(() => fallbackCopy(abs, done));
        } else {
          fallbackCopy(abs, done);
        }
      }
    });
    function fallbackCopy(text: string, done: () => void) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch {}
      document.body.removeChild(ta);
    }
  })();
</script>

<style>
  .share-buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; }
  .share-btn { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.45rem 0.85rem; border-radius: 8px;
    border: 1px solid var(--border-color); background: var(--comp-bg-blur); color: var(--app-text-pri);
    font-size: 0.82rem; cursor: pointer; transition: border-color 0.15s ease; }
  .share-btn:hover { border-color: var(--accent); }
</style>