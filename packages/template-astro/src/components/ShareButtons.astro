  },
};
---
{channels.length > 0 && (
  <div class="share-buttons">
    {channels.map((kind: string) => {
      const def = CHANNEL_DEFS[kind];
      if (!def) return null;
      return (
        <button type="button" class="share-btn" data-share={kind === 'copy-link' ? 'copy' : kind} data-url={postUrl} data-title={postTitle}>
          <span set:html={def.icon} />
        </button>
      );
    })}
  </div>
)}

<script is:inline>
  (() => {
    const base = location.origin;
    document.addEventListener('click', (e) => {
      const btn = (e.target).closest?.('.share-btn') ;
      if (!btn) return;
      const kind = btn.dataset.share;
      const rel = btn.dataset.url || '';
      const title = btn.dataset.title || document.title;
      const abs = rel.startsWith('http') ? rel : base + (rel.startsWith('/') ? rel : '/' + rel);
      if (kind === 'twitter') {
        window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'weibo') {
        window.open('https://service.weibo.com/share/share.php?title=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'wechat' || kind === 'moments') {
        // 微信/朋友圈无网页分享 API → 打开当前页二维码（扫码分享）
        window.open('https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'linkedin') {
        window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(abs), '_blank', 'noopener');
      } else if (kind === 'copy') {
        const done = () => {
          const old = btn.textContent;
          btn.textContent = '已复制 ✓';
          setTimeout(() => { btn.textContent = old; }, 1500);
        };
        if (navigator.clipboard?.writeText) {
          navigator.clipboard.writeText(abs).then(done).catch(() => fallbackCopy(abs, done));
        } else {
          fallbackCopy(abs, done);
        }
      }
    });
    function fallbackCopy(text, done) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed'; ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); done(); } catch {}
      document.body.removeChild(ta);
    }
  })();
</script>

<style>
  .share-buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.25rem; align-items: center; justify-content: center;}
  .share-btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.8rem; border-radius: 8px;
    background: transparent; color: var(--app-text-sec); border: none;
    cursor: pointer; transition: background 0.15s ease, color 0.15s ease; }
  .share-btn:hover { background: var(--hover);color: var(--app-text-pri); }
</style>