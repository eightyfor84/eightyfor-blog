---
interface Props {
  post: any;
  locale: string;
  lang: string;
  channels?: string[];
}
const { post, locale, lang, channels = ['twitter', 'weibo', 'wechat', 'moments', 'linkedin', 'copy-link'] } = Astro.props as Props;
const postUrl = `/${lang}/post/${encodeURIComponent(post?.id || '')}`;
const postTitle = String(post?.title || '');

