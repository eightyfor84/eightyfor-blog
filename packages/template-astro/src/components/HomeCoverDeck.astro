---
import { readFileSync, existsSync } from 'node:fs';
import { join } from 'node:path';

const { locale, themePostPath, mode = 'cover', siteName, siteDescription } = Astro.props;
const isSplit = mode === 'split';

const dataDir = process.env.CHRONICLE_DATA_DIR || join(process.cwd(), '..', '..', 'data');
const coverHtmlPath = join(dataDir, 'homepage-cover.html');
const raw = existsSync(coverHtmlPath) ? readFileSync(coverHtmlPath, 'utf-8') : '';
const coverHtml = raw
  ? raw.replace('{{themePostPath}}', themePostPath || '')
  : '';

const siteTitle = siteName || 'Chronicle';
const siteDesc = siteDescription || 'A personal blog';

const FALLBACK_COVER_HTML = `<style>
  /* Shell — layout & positioning */
  .home-cover-deck { position: relative; z-index: 3; }
  .home-cover-deck--split { width: 100%; display: block; }
  .hero { position: relative; z-index: 10; left: 15vw; transform: translateY(-20%); }
  .hero--split { position: relative; margin: 0; transform-origin: left bottom; will-change: transform, opacity; }
  @media (max-width:760px) { .hero { left: 60px; transform: translateY(-10%); } }

  /* Cover content */
  .cover-title { font-size:3.5rem; font-weight:600; font-variation-settings:"wght" 600; color:var(--app-text-primary); margin:0 0 1rem 0; line-height:1.1; }
  .cover-subtitle { font-size:1.15rem; color:var(--app-text-secondary); margin:0 0 2.5rem 0; line-height:1.5; max-width:480px; }
  .cover-cta { display:inline-flex; align-items:center; gap:8px; padding:12px 28px; background:var(--accent-color); color:#fff; border:none; border-radius:8px; font-size:1rem; font-weight:500; cursor:pointer; text-decoration:none; transition:filter 0.2s, transform 0.2s; }
  .cover-cta:hover { filter: brightness(1.6); transform: scale(1.05); color: #000;}
  .cover-cta svg { width:20px; height:20px; }
  @media (max-width:760px) { .cover-title { font-size:2.2rem; } .cover-subtitle { font-size:1rem; margin-bottom:2rem; } }
</style>
<div class="hero-inner">
  <h1 class="cover-title">${siteTitle}</h1>
  <p class="cover-subtitle">${siteDesc}</p>
  <a href="blogs/" class="cover-cta">
    <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
    View Posts
  </a>
</div>`;
---

<div class:list={['home-cover-deck', isSplit ? 'home-cover-deck--split' : '']}>
  <div class:list={['hero', isSplit ? 'hero--split' : 'home-cover-hero']} id={isSplit ? 'split-hero' : undefined}>
    <Fragment set:html={coverHtml || FALLBACK_COVER_HTML} />
  </div>
</div>

