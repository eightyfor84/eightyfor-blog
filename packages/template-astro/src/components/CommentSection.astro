---
/**
 * CommentSection — client:visible island, backend-agnostic.
 *
 * Supported backends (via `data-comment-backend`):
 *   "" (empty)   → static SSR only — reads data/comments/{postId}.json at build time
 *   "waline"     → Waline headless REST API, rendered with Chronicle's own UI
 *
 * Props:
 *   postId          — unique post identifier
 *   comments        — pre-fetched comments (overrides file read)
 *   locale          — i18n locale ("en" | "zh-CN")
 *   backend         — "" | "waline"
 *   walineServerUrl — Waline server URL, for "waline" backend
 *
 * SSR: renders static comments from data/comments/{postId}.json ("" backend only).
 * Hydration (IntersectionObserver): for "waline", fetches + renders the comment
 *   list via the Waline REST API and wires up the Chronicle comment form — no
 *   third-party SDK or UI is ever loaded.
 */
import { createHash } from 'node:crypto';
import { getTranslation } from '../utils/i18n';
import { getComments, buildCommentTree, type ChronicleComment } from '../data/localDataSource';

interface Props {
  postId?: string;
  comments?: ChronicleComment[];
  locale?: string;
  backend?: string;
  walineServerUrl?: string;
  /** 3.1.x — show commenter geo address (never the raw IP) when available. */
  showGeoAddress?: boolean;
}

const {
  postId,
  comments: propComments,
  locale = 'en',
  backend = '',
  walineServerUrl = '',
  showGeoAddress = true,
} = Astro.props as Props;

const t = (key: string) => getTranslation(locale as 'en' | 'zh-CN', key);

/** MD5 hash for Gravatar URL (SSR only) */
function md5Hash(str: string): string {
  return createHash('md5').update(str).digest('hex');
}

/** SSR fallback date formatter (replaced by client-side relative dates on hydration) */
function formatDate(iso: string): string {
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
  } catch {
    return iso;
  }
}

// Load comments: prop > localDataSource > empty
let comments: ChronicleComment[] = propComments || [];
if (!propComments && postId) {
  comments = getComments(postId);
}

/** 评论内容图懒加载（静态渲染路径——客户端动态拉取已由 applyMediaLazyLoad 处理） */
function lazyCommentImages(content: string): string {
  return content.replace(/<img(?![^>]*\bloading=)/gi, '<img loading="lazy" decoding="async"');
}
comments = comments.map((c) => ({ ...c, content: lazyCommentImages(c.content || '') }));

// Build tree from flat parent references, filter hidden
const commentTree = buildCommentTree(comments).filter(c => !c.hidden);

function countReplies(nodes: any[]): number {
  return nodes.reduce((s, n) => s + 1 + countReplies(n.replies || []), 0);
}
const commentCount = countReplies(commentTree);
const sectionTitle = t('comment.title');
const isEmpty = commentTree.length === 0;

// i18n strings needed by the client (Waline hydration). Single source of truth = locale files.
const clientI18n = {
  reply: t('comment.reply'),
  replyTo: t('comment.replyTo'),
  pinned: t('comment.pinned'),
  loading: t('comment.loading'),
  loadError: t('comment.loadError'),
  noComments: t('comment.noComments'),
  submitted: t('comment.submitted'),
  submitError: t('comment.submitError'),
};
---

<div
  class="comment-section"
  id="comments"
  data-post-id={postId || ''}
  data-comment-backend={backend}
  data-waline-server-url={walineServerUrl}
  data-show-geo={showGeoAddress ? 'true' : 'false'}
  data-locale={locale}
>
  <script type="application/json" data-role="comment-i18n" set:html={JSON.stringify(clientI18n)}></script>

  {backend === 'waline' ? (
  <form class="cs-form" data-role="comment-form">
    <div class="cs-form-row">
      <input class="cs-form-input" data-role="author" type="text" placeholder={t('comment.namePlaceholder')} autocomplete="name" required />
      <input class="cs-form-input" data-role="email" type="email" placeholder={t('comment.emailPlaceholder')} autocomplete="email" required />
      <input class="cs-form-input" data-role="website" type="url" placeholder={t('comment.websitePlaceholder')} autocomplete="url" />
    </div>
    <textarea class="cs-form-textarea" data-role="content" placeholder={t('comment.contentPlaceholder')} required></textarea>

    <div class="cs-attachments" data-role="attachments" hidden></div>

    <div class="cs-form-footer">
      <div class="cs-reply-indicator" data-role="reply-indicator" hidden>
        <span>{t('comment.replyingTo')} <strong data-role="reply-target"></strong></span>
        <button type="button" class="cs-reply-cancel" data-role="reply-cancel" aria-label="Cancel"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="height: 16px; width: 16px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
      </div>
      <div class="cs-form-actions">
        <button type="button" class="cs-image-btn" data-role="image-btn" aria-label={t('comment.imageUpload')} title={t('comment.imageUpload')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        </button>
        <button type="button" class="cs-preview-toggle" data-role="preview-toggle">{t('comment.preview')}</button>
        <button type="submit" class="cs-submit-btn" data-role="submit">{t('comment.submit')}</button>
      </div>
    </div>

    <div class="cs-form-preview" data-role="preview" hidden></div>
    <div class="cs-form-note" data-role="form-note" hidden></div>

    <input type="hidden" data-role="parent" />
    <input type="hidden" data-role="root" />
    <input type="file" data-role="image-input" accept="image/*" hidden />
  </form>
  ) : (
    !backend && (
      <div class="cs-form-placeholder">
        <p>{t('comment.staticPlaceholder')}</p>
      </div>
    )
  )}

  <!-- Comment list header -->
  <div class="cs-header">
    <h2 class="cs-title">{sectionTitle}</h2>
    <span class="cs-count" style={commentCount > 0 ? '' : 'display:none'}>{commentCount}</span>
  </div>

  <!-- Comment list -->
  <div class="cs-list">
    {isEmpty ? (
      <div class="cs-empty">
        <svg class="cs-empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        <p class="cs-empty-text">{t('comment.noComments')}</p>
      </div>
    ) : (
      commentTree.map((comment) => (
        <div class="cs-thread">
          <div class="cs-comment" id={`comment-${comment.id}`}>
            <div class="cs-avatar">
              {comment.email ? (
                <img
                  src={`https://www.gravatar.com/avatar/${md5Hash(comment.email.trim().toLowerCase())}?s=80&d=identicon&r=g`}
                  alt={`${comment.author}'s avatar`}
                  class="cs-avatar-img"
                  loading="lazy"
                  width="40"
                  height="40"
                />
              ) : (
                <span class="cs-avatar-initial">{comment.author.charAt(0).toUpperCase()}</span>
              )}
            </div>
            <div class="cs-body">
              <div class="cs-meta">
                <span class="cs-author">
                  {comment.website ? (
                    <a href={comment.website} rel="nofollow noopener" target="_blank">{comment.author}</a>
                  ) : (
                    comment.author
                  )}
                </span>
                <span class="cs-date" data-date={comment.date}>
                  {formatDate(comment.date)}
                </span>
                {showGeoAddress && comment.location && (
                  <span class="cs-location">{comment.location}</span>
                )}
              </div>
              <div class="cs-content" set:html={comment.content} />
            </div>
          </div>

          {comment.replies && comment.replies.length > 0 && (
            <div class="cs-replies">
              {comment.replies.map((reply) => (
                <div class="cs-comment cs-comment--reply" id={`comment-${reply.id}`}>
                  <div class="cs-avatar">
                    {reply.email ? (
                      <img
                        src={`https://www.gravatar.com/avatar/${md5Hash(reply.email.trim().toLowerCase())}?s=60&d=identicon&r=g`}
                        alt={`${reply.author}'s avatar`}
                        class="cs-avatar-img cs-avatar-img--sm"
                        loading="lazy"
                        width="32"
                        height="32"
                      />
                    ) : (
                      <span class="cs-avatar-initial cs-avatar-initial--sm">{reply.author.charAt(0).toUpperCase()}</span>
                    )}
                  </div>
                  <div class="cs-body">
                    <div class="cs-meta">
                      <span class="cs-author">{reply.author}</span>
                      <span class="cs-date" data-date={reply.date}>
                        {formatDate(reply.date)}
                      </span>
                      {showGeoAddress && reply.location && (
                        <span class="cs-location">{reply.location}</span>
                      )}
                    </div>
                    <div class="cs-content" set:html={reply.content} />
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      ))
    )}
  </div>
</div>

<script>
  import { hydrateCommentSection } from '../utils/commentAdapter';

  let _csCleanup: (() => void) | null = null;

  function _csMount() {
    if (_csCleanup) return;
    _csCleanup = hydrateCommentSection();
  }

  function _csUnmount() {
    if (_csCleanup) { _csCleanup(); _csCleanup = null; }
  }

  document.addEventListener('astro:page-load', _csMount);
  document.addEventListener('astro:before-swap', _csUnmount);
  // Run immediately for first paint
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', _csMount, { once: true });
  } else {
    _csMount();
  }
</script>

<style is:global>
  /* ═══════════════════════════════════════════════════════════
     CommentSection — Chronicle design system
     NOTE: is:global because commentAdapter.ts injects HTML dynamically
     (client-side rendering for the waline backend),
     and scoped styles won't match JS-generated DOM.
     All selectors are namespaced inside .comment-section to avoid leaks.
     ═══════════════════════════════════════════════════════════ */

  .comment-section {
    padding: 0 max(20px,min((6vw - 10px),60px)) 40vh;
  }

  /* The `hidden` attribute is neutralized when a class also sets `display`
     (e.g. .cs-reply-indicator's inline-flex, .cs-attachments' flex), because
     author styles override the UA's `[hidden] { display:none }`. Force it back
     so reply-indicator / attachments / notes actually disappear when hidden. */
  .comment-section [hidden] {
    display: none !important;
  }

  .cs-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-color);
  }

  .cs-title {
    font-size: 1.35rem;
    font-weight: 600;
    font-variation-settings: "wght" 600;
    color: var(--app-text-pri);
    margin: 0;
  }

  .cs-count {
    font-size: 0.85rem;
    color: var(--app-text-sec);
    background: var(--comp-bg);
    padding: 0.15em 0.6em;
    border-radius: 1em;
  }

  .cs-empty {
    text-align: center;
    padding: 3rem 1rem;
    color: var(--app-text-sec);
  }

  .cs-empty-icon {
    width: 48px;
    height: 48px;
    opacity: 0.35;
    margin-bottom: 0.75rem;
  }

  .cs-empty-text {
    font-size: 0.95rem;
    margin: 0;
  }

  .cs-loading {
    text-align: center;
    padding: 2rem 1rem;
    color: var(--app-text-sec);
    font-size: 0.9rem;
  }

  .cs-thread {
    margin-bottom: 0.75rem;
  }

  .cs-comment {
    display: flex;
    gap: 0.85rem;
    padding: 1rem 1.1rem;
    background: transparent;
    border-radius: 10px;
    transition: background 0.15s;
  }

  .cs-comment:hover {
    background: var(--hover);
  }

  .cs-comment--reply {
    margin-left: 3rem;
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }

  .cs-avatar {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
  }

  .cs-avatar-img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--comp-bg-alt);
  }

  .cs-avatar-img--sm {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--comp-bg-alt);
  }

  .cs-avatar-initial {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--accent-bg);
    color: var(--accent);
    font-size: 1.1rem;
    font-weight: 600;
  }

  .cs-avatar-initial--sm {
    width: 32px;
    height: 32px;
    font-size: 0.9rem;
  }

  .cs-body {
    flex: 1;
    min-width: 0;
  }

  .cs-meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.35rem;
    flex-wrap: wrap;
  }

  .cs-author {
    font-size: 0.9rem;
    font-weight: 600;
    font-variation-settings: "wght" 600;
    color: var(--app-text-sec);
  }

  .cs-author a {
    color: var(--accent);
    font-weight: 600;
    font-variation-settings: "wght" 600;
    text-decoration: none;
  }

  .cs-author a:hover {
    text-decoration: underline;
  }

  .cs-reply-to {
    font-size: 0.78rem;
    color: var(--comp-text-pri);
    opacity: 0.8;
  }

  .cs-pinned-badge {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-bg);
    padding: 0.1em 0.55em;
    border-radius: 0.5em;
    line-height: 1.4;
    white-space: nowrap;
  }

  .cs-location {
    font-size: 0.72rem;
    color: var(--comp-text-sec, var(--app-text-sec));
    background: var(--comp-bg, rgba(128,128,128,0.08));
    padding: 0.1em 0.55em;
    border-radius: 999px;
    white-space: nowrap;
  }

  .cs-date {
    font-size: 0.78rem;
    color: var(--app-text-sec);
    white-space: nowrap;
    opacity: 0.5;
  }

  .cs-content {
    font-size: 0.93rem;
    line-height: 1.6;
    color: var(--app-text-pri);
    word-break: break-word;
  }

  .cs-content p {
    margin: 0 0 0.5rem;
  }

  .cs-content p:last-child {
    margin-bottom: 0;
  }

  .cs-content img {
    max-width: 100%;
    max-height: 240px;
    border-radius: 4px;
  }

  .cs-replies {
    margin-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cs-reply-btn {
    border: none;
    background: transparent;
    color: var(--app-text-sec);
    font-size: 0.78rem;
    cursor: pointer;
    padding: 0;
    margin-top: 0.35rem;
    opacity: 0.7;
    transition: opacity 0.15s, color 0.15s;
  }

  .cs-reply-btn:hover {
    opacity: 1;
    color: var(--accent);
  }

  /* ── Comment form (Waline backend) ─────────────────────── */

  .cs-form {
    margin-bottom: 2rem;
  }

  .cs-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.6rem;
    margin-bottom: 0.6rem;
  }

  .cs-form-input,
  .cs-form-textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.85rem;
    font-size: 0.9rem;
    font-family: inherit;
    color: var(--app-text-pri);
    background: var(--comp-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .cs-form-input::placeholder,
  .cs-form-textarea::placeholder {
    color: var(--app-text-sec);
    opacity: 0.6;
  }

  .cs-form-input:focus,
  .cs-form-textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-bg);
  }

  .cs-form-textarea {
    min-height: 6rem;
    resize: vertical;
    line-height: 1.6;
  }

  .cs-attachments {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.6rem;
  }

  .cs-attachment {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.45rem;
    background: var(--comp-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    font-size: 0.82rem;
    color: var(--app-text-sec);
    max-width: 100%;
  }

  .cs-attachment-thumb {
    width: 32px;
    height: 32px;
    border-radius: 6px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--comp-bg-alt);
  }

  .cs-attachment-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 12rem;
  }

  .cs-attachment-remove {
    border: none;
    background: transparent;
    color: var(--app-text-sec);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0 0.15rem;
    flex-shrink: 0;
  }

  .cs-attachment-remove:hover {
    color: var(--app-text-pri);
  }

  .cs-form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.6rem;
    flex-wrap: wrap;
  }

  .cs-form-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .cs-reply-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--app-text-sec);
    background: var(--comp-bg-alt);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
  }

  .cs-reply-cancel {
    border: none;
    background: transparent;
    color: var(--app-text-sec);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 0;
  }

  .cs-reply-cancel:hover {
    color: var(--app-text-pri);
  }

  .cs-image-btn,
  .cs-preview-toggle,
  .cs-submit-btn {
    border: 1px solid var(--border-color);
    background: transparent;
    color: var(--app-text-sec);
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s, filter 0.15s;
  }

  .cs-image-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 0.6rem;
  }

  .cs-image-btn svg {
    width: 1rem;
    height: 1rem;
  }

  .cs-image-btn:hover,
  .cs-preview-toggle:hover {
    background: var(--hover);
    color: var(--app-text-pri);
  }

  .cs-submit-btn {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    font-weight: 600;
  }

  .cs-submit-btn:hover:not(:disabled) {
    filter: brightness(1.05);
  }

  .cs-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .cs-form-preview {
    margin-top: 0.6rem;
    padding: 0.75rem 0.9rem;
    background: var(--comp-bg);
    border: 1px dashed var(--border-color);
    border-radius: 8px;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--app-text-pri);
    white-space: normal;
    word-break: break-word;
  }

  .cs-form-preview :where(p, ul, ol, blockquote, pre) {
    margin: 0 0 0.5rem;
  }

  .cs-form-preview :where(p, ul, ol, blockquote, pre):last-child {
    margin-bottom: 0;
  }

  .cs-form-preview :where(ul, ol) {
    padding-left: 1.25rem;
  }

  .cs-form-preview :where(img) {
    max-width: 100%;
    border-radius: 6px;
  }

  .cs-form-preview :where(pre) {
    padding: 0.5rem 0.7rem;
    background: var(--comp-bg-alt);
    border-radius: 6px;
    overflow-x: auto;
  }

  .cs-form-preview :where(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85em;
  }

  .cs-form-note {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--app-text-sec);
  }

  .cs-form-note--error {
    color: #e5484d;
  }

  .cs-form-placeholder {
    text-align: center;
    padding: 2rem 1rem;
    margin-bottom: 2rem;
    color: var(--app-text-sec);
    font-size: 0.9rem;
  }

  @media (max-width: 600px) {
    .cs-form-row {
      grid-template-columns: 1fr;
    }

    .cs-comment--reply {
      margin-left: 1.5rem;
    }
  }

  @media (max-width: 500px) {
    .cs-comment {
      padding: 0.85rem;
    }

    .cs-avatar {
      width: 34px;
      height: 34px;
    }

    .cs-avatar-img,
    .cs-avatar-initial {
      width: 34px;
      height: 34px;
    }
  }
</style>
