---
import RelatedPosts from './RelatedPosts.astro';
import PrevNextNav from './PrevNextNav.astro';
import AuthorCard from './AuthorCard.astro';
import ShareButtons from './ShareButtons.astro';
import type { Locale } from '../utils/i18n';

interface Props {
  post: any;
  /** Display locale ('zh-CN' | 'en') — dates/i18n. */
  locale: Locale;
  /** Route prefix ('zh' | 'en') — URL building. */
  lang: string;
  cfg?: any;
}
const { post, locale, lang, cfg = {} } = Astro.props as Props;
const showRelated = cfg.relatedPosts !== false;
const showPrevNext = cfg.prevNext !== false;
const showShare = cfg.share !== false;
const showAuthor = cfg.authorCard !== false;
---

<div class="end-of-article">
  {showPrevNext && <PrevNextNav post={post} locale={locale} lang={lang} mode={cfg.prevNextMode || 'both'} scope={cfg.prevNextScope || 'global'} />}
  {showRelated && <RelatedPosts post={post} locale={locale} lang={lang} />}
  {showAuthor && <AuthorCard locale={locale} post={post} />}
  {showShare && <ShareButtons post={post} locale={locale} lang={lang} channels={cfg.shareChannels} />}
</div>

<style>
  .end-of-article { display: flex; flex-direction: column; gap: 1.5rem; margin-top: 2rem; padding: 0 max(20px,min((6vw - 10px),60px)); }
</style>
