---
const props = (Astro.props || {}) as {
  instanceId?: string;
  searchSuggestionsEnabled?: boolean;
  showTagTrigger?: boolean;
  initialTitle?: string;
  featuredLabel?: string;
  routePrefix?: string;
  t?: (k: string) => string;
  searchOnEnter?: boolean;
  searchBtnAsButton?: boolean;
};

const searchSuggestionsEnabled = props.searchSuggestionsEnabled ?? false;
const showTagTrigger = props.showTagTrigger ?? props.searchSuggestionsEnabled ?? false;
const instanceId = props.instanceId ?? 'searchbox';
const initialTitle = props.initialTitle ?? '';
const featuredLabel = props.featuredLabel ?? '';
const routePrefix = props.routePrefix ?? '/';
const t = props.t ?? ((k: string) => k);
const searchOnEnter = props.searchOnEnter ?? true;
const searchBtnAsButton = props.searchBtnAsButton ?? true;
---

<div
  class="search-box-wrapper"
  data-searchbox-id={instanceId}
  data-searchbox-config={JSON.stringify({ instanceId, initialTitle, searchOnEnter, searchBtnAsButton, showTagTrigger })}
>
  <div class="search-box mtl-surface">
    {showTagTrigger && (
      <>
        <button
          class="tag-trigger"
          id="tag-trigger"
          title={t("search.selectTags")}
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <line x1="4" y1="9" x2="20" y2="9"></line>
            <line x1="4" y1="15" x2="20" y2="15"></line>
            <line x1="10" y1="3" x2="8" y2="21"></line>
            <line x1="16" y1="3" x2="14" y2="21"></line>
          </svg>
        </button>
        <span class="divider"></span>
      </>
    )}

    <div class="input-area" id="input-area">
      <input
        id="search-input"
        type="text"
        placeholder={t("search.placeholder")}
        class="search-input"
        value={initialTitle}
      />
    </div>

    <button class="clear-btn" id="clear-btn" title="清空搜索" style="display:none;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    {searchBtnAsButton ? (
      <button class="search-btn" id="search-btn" type="button" title={t("search.search")} data-search-btn="true" disabled={initialTitle.trim().length === 0}>
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      </button>
    ) : (
      <div class="search-btn search-btn--static" id="search-btn" title={t("search.search")} aria-hidden="true" aria-disabled="true">
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
      </div>
    )}
  </div>
</div>

<script>
  import '../scripts/search-bootstrap';
</script>

<style>
  .search-box-wrapper {
    flex-shrink: 0;
    margin-bottom: 2rem;
    z-index: 50;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .search-box {
    display: flex;
    align-items: center;
    border-radius: 12px;
    padding: 4px;
    transition: box-shadow 0.3s ease;
  }
  .search-box:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--comp-bg-accent-blur);
  }

  .divider {
    width: 1px;
    height: 28px;
    background-color: var(--border-color-blur);
    margin: 0 2px;
  }

  .tag-trigger {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 12px;
    color: var(--comp-text-sec);
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.3s ease, transform 0.1s ease, background-color 0.3s ease;
    flex-shrink: 0;
    border-radius: 8px;
    position: relative;
  }
  .tag-trigger.active:not(.featured) {
    color: var(--accent);
  }

  .tag-trigger.selected {
    background: var(--comp-bg-accent-blur);
    color: var(--accent);
  }

  .tag-trigger.selected.featured {
    background: var(--featured-bg);
    color: var(--featured);
  }

  .tag-trigger.selected:hover {
    filter: brightness(1.1);
  }
  .tag-trigger.selected.featured:hover {
    filter: brightness(1.1);
  }

  .tag-trigger:not(.featured):hover {
    color: var(--accent);
  }

  .tag-count {
    background: var(--app-bg-pri);
    color: var(--comp-text-sec);
    font-size: 0.75rem;
    font-weight: 500;
    font-variation-settings: 'wght' 500;
    padding: 2px 6px;
    border-radius: 10px;
    min-width: 16px;
    text-align: center;
    line-height: 1;
    align-content: center;
  }

  .tag-trigger .tag-count{
    width:16px;
    height:16px;
  }

  .search-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 12px;
    color: var(--comp-text-sec);
    display: flex;
    align-items: center;
    transition:
      color 0.3s ease,
      transform 0.1s ease,
      background-color 0.3s ease;
    flex-shrink: 0;
    border-radius: 8px;
  }

  .search-btn--static {
    cursor: default;
    pointer-events: none;
    opacity: 0.7;
  }

  .search-btn:not(.active) {
    opacity: 0.7;
    cursor: default;
  }
  .search-btn.active {
    background-color: var(--accent);
    color: var(--recommended-accent-text);
  }

  .input-area {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 4px 10px;
    gap: 6px;
    cursor: text;
    min-width: 100px !important;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--app-text-pri);
    font-size: 1rem;
    padding: 6px 0;
    outline: none;
  }

  .clear-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 8px 12px;
    color: var(--comp-text-sec);
    display: flex;
    align-items: center;
    transition: all 0.3s ease;
    flex-shrink: 0;
    border-radius: 8px;
    opacity: 0.7;
  }

  .clear-btn:hover {
    color: var(--comp-text-pri-hvr);
    opacity: 1;
  }
</style>
