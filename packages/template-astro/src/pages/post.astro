---
// Redirect /post/<id> → /{lang}/post/<id>
---
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1.0" /><title>Redirecting…</title></head>
  <body>
    <script>
      const lang = navigator.language?.startsWith('zh') ? 'zh' : 'en';
      window.location.replace('/' + lang + '/blogs' + window.location.search + window.location.hash);
    </script>
  </body>
</html>
