---
// Redirect / → /{lang}/
---
<html lang="en">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width,initial-scale=1.0" /><title>Redirecting…</title></head>
  <body>
    <script>
      const l=window.location.pathname.includes('/zh')?'/zh':'/en';
      window.location.replace(l+'/'+window.location.search+window.location.hash);
    </script>
  </body>
</html>
