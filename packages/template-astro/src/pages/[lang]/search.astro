---
// ── 主板路由壳：/search ─────────────────────────────────
// 路由归主板（恒构建，与原 search.astro 行为一致——搜索页不随 flag 门控，
// 入口（NavHeader 按钮/overlay）才随 globalSearch flag）；页面体由 search 簇注册。
import { getClusterPage } from '../../clusters';

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const SearchPage = getClusterPage('search', 'search');
---
{SearchPage ? <SearchPage /> : null}
