---
// ── 主板路由壳：/collection ──────────────────────────────
// 路由与特性门控归主板；页面体由 collections 簇注册（getClusterPage）。
import { getClusterPage } from '../../clusters';
import { resolveFeatureFlags } from '../../utils/featureFlags';
import { loadSiteSettings } from '../../utils/siteSettings';

export const prerender = true;

export async function getStaticPaths() {
  const settings = await loadSiteSettings();
  const featureFlags = resolveFeatureFlags(settings?.featureFlags);
  if (featureFlags.collectionPage === false) return [];
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const CollectionPage = getClusterPage('collections', 'collection');
---
{CollectionPage ? <CollectionPage /> : null}
