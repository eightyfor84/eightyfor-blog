---
export const prerender = true;

export async function getStaticPaths() {
  const settings = await loadSiteSettings();
  const featureFlags = resolveFeatureFlags(settings?.featureFlags);
  if (featureFlags.aboutPage === false) return [];
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

import Layout from '../../layouts/Layout.astro';
import { getTranslation, getLocale } from '../../utils/i18n';
import { resolveFeatureFlags } from '../../utils/featureFlags';
import { loadSiteSettings } from '../../utils/siteSettings';
import { renderChronicleMarkdown } from '../../utils/chronicleMarkdown';
import { getProfile } from '../../data/localDataSource';
import chronicleMarkdownCssUrl from '@chronicle/shared/src/styles/chronicle-markdown.css?url';
import fs from 'fs';
import path from 'path';

const locale = getLocale(Astro.locals);
const t = (key: string) => getTranslation(locale, key);

const settings = await loadSiteSettings();

// Profile card
const profile = getProfile() as Record<string, any>;
const showProfileCard = profile?.showProfileCard !== false;

// About markdown — same pipeline as post rendering
import { setRenderPostId } from '../../utils/chronicleMarkdown';
import ChronicleImage from '../../components/ChronicleImage.astro';
const DATA_DIR = process.env.CHRONICLE_DATA_DIR
  ? path.resolve(process.env.CHRONICLE_DATA_DIR)
  : path.resolve(process.cwd(), '..', '..', 'data');
const aboutPath = path.join(DATA_DIR, '__about__', 'index.md');

let aboutHtml = '';
let lastModified: string | null = null;
try {
  if (fs.existsSync(aboutPath)) {
    const raw = fs.readFileSync(aboutPath, 'utf-8');
    const bodyMatch = raw.match(/^---\n[\s\S]*?\n---\n\n?/);
    const content = bodyMatch ? raw.slice(bodyMatch[0].length) : raw;
    const lastModMatch = raw.match(/^lastModified:\s*(.+)$/m);
    if (lastModMatch) lastModified = lastModMatch[1].trim();
    if (!lastModified) lastModified = fs.statSync(aboutPath).mtime.toISOString().slice(0, 10);

    setRenderPostId('__about__');
    aboutHtml = renderChronicleMarkdown(content, Astro.params.lang);
  }
} catch {}

const pageTitle = locale === 'zh-CN' ? '关于' : 'About';
const metaDescription = profile?.bio
  ? String(profile.bio).slice(0, 160)
  : (locale === 'zh-CN' ? '关于页面' : 'About page');
---

<Layout title={pageTitle} settings={settings} locale={locale} meta={{ description: metaDescription }}>
  <!-- chronicle-markdown.css render-blocking in <head>: single source of truth for
       .chr-md typography metrics (shared with CMS preview). Deferring it reflowed the
       page after first paint (CLS). data-render-blocking opts out of the
       chronicle-defer-astro-css rewrite (astro.config.mjs). -->
  <Fragment slot="head">
    <link rel="stylesheet" href={chronicleMarkdownCssUrl} data-render-blocking />
  </Fragment>
  <main class="about-page">
    <article class="about-article">
      <h1 class="about-title">{pageTitle}</h1>

      {
        showProfileCard && (profile?.name || profile?.avatar || profile?.bio) ? (
          <div class="about-profile-card">
            {profile.avatar ? (
              <ChronicleImage src={profile.avatar} alt={profile.name || ''} class="about-avatar" loading="lazy" decoding="async" style="cursor:pointer" onclick="window.__openFilePreview?.({ url: event.target.src, title: event.target.alt, type: 'image' })" />
            ) : null}
            <div class="about-profile-body">
              {profile.name ? <h2 class="about-name">{profile.name}</h2> : null}
              {profile.bio ? <p class="about-bio">{profile.bio}</p> : null}
              {profile.location ? (
                <span class="about-location">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                  {profile.location}
                </span>
              ) : null}
              {profile.links?.length ? (
                <div class="about-links">
                  {profile.links.map((link: { label: string; url: string }) => (
                    <a
                      class="about-link"
                      href={link.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ) : null}
            </div>
          </div>
        ) : null
      }

      {
        aboutHtml ? (
          <div class="chr-md" set:html={aboutHtml} />
        ) : (
          <div class="about-empty">
            <p>{locale === 'zh-CN' ? '暂无内容。' : 'Nothing here yet.'}</p>
          </div>
        )
      }

      {
        lastModified ? (
          <div class="about-last-modified">
            <span class="about-modified-label">
              {locale === 'zh-CN' ? '最后更新' : 'Last updated'}:
            </span>
            <time datetime={lastModified}>{lastModified}</time>
          </div>
        ) : null
      }
    </article>
  </main>
</Layout>

<style>
.about-page {
  max-width: 860px;
  margin: 0 auto;
  padding: 48px 24px 64px;
}

.about-article {
  color: var(--comp-text-pri);
}

.about-title {
  font-size: 2.4rem;
  font-weight: 700;
  margin: 0 0 32px;
  padding: 0 0 16px;
}

.about-empty {
  padding: 48px 0;
  text-align: center;
  color: var(--comp-text-sec);
  font-size: 1rem;
}

/* Profile Card */
.about-profile-card {
  display: flex;
  gap: 20px;
  padding: 20px 24px;
  margin: 0 0 36px;
  background: var(--comp-bg-blur);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  align-items: center;
  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.25);
}

.about-avatar {
  width: 88px;
  height: 88px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
}

.about-profile-body {
  flex: 1;
  min-width: 0;
}

.about-name {
  font-size: 1.25rem;
  font-weight: 600;
  font-variation-settings: 'wght' 600;
  margin: 0 0 6px;
}

.about-bio {
  font-size: 0.95rem;
  color: var(--comp-text-sec);
  margin: 0 0 8px;
  line-height: 1.55;
}

.about-location {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.85rem;
  color: var(--comp-text-sec);
  margin: 0 0 6px;
}

.about-links {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
}

.about-link {
  display: inline-block;
  padding: 4px 12px;
  border: 1px solid var(--comp-border);
  border-radius: 999px;
  font-size: 0.85rem;
  color: var(--comp-text-pri);
  text-decoration: none;
  transition: border-color 0.15s;
}

.about-link:hover {
  border-color: var(--comp-text-sec);
}

/* Last Modified */
.about-last-modified {
  margin-top: 40px;
  padding-top: 16px;
  border-top: 1px solid var(--comp-border);
  font-size: 0.85rem;
  color: var(--comp-text-sec);
}

.about-modified-label {
  margin-right: 4px;
}

@media (max-width: 600px) {
  .about-profile-card {
    flex-direction: column;
    text-align: center;
  }
  .about-links {
    justify-content: center;
  }
}
</style>

<script>
  import('../../utils/mathTooltip').then(({ initMathTooltip }) => {
    initMathTooltip(document.querySelector('.chr-md'));
  }).catch(() => {});
</script>
