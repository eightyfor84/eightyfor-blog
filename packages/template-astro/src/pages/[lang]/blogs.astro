---
import Layout from '../../layouts/Layout.astro';
import BackToTop from '../../components/BackToTop.astro';
import BlogPostCard from '../../components/BlogPostCard.astro';
import { getTranslation } from '../../utils/i18n';
import { toContentLocale } from '../../utils/routeLocale';
import { getPublishedPosts } from '../../data/localDataSource';
import { loadSiteSettings } from '../../utils/siteSettings';

export const prerender = true;

export async function getStaticPaths() {
  return [{ params: { lang: 'zh' } }, { params: { lang: 'en' } }];
}

const routeLang = Astro.params.lang === 'en' ? 'en' : 'zh';
const locale = toContentLocale(routeLang);
const t = (key: string) => getTranslation(locale, key);

// ── Local data source (fully SSR — no client fetching) ──────
const allPublished = getPublishedPosts();
const sorted = [...allPublished].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Featured = posts with 'featured' or '精选' tag
const featured = sorted.filter(p => (p.tags || []).some((t: string) => {
  const nt = String(t).trim().toLowerCase();
  return nt === 'featured' || nt === '精选';
}));

const settings = await loadSiteSettings();

const formatMonthName = (iso: string) => {
  try {
    return new Date(iso).toLocaleString(locale, { month: 'short' });
  } catch (e) {
    return '';
  }
};

const buildArchiveGroups = (posts: any[]) => {
  const sortedPosts = [...posts].sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
  const yearMap = new Map<number, Map<number, { monthName: string; posts: any[] }>>();

  sortedPosts.forEach((post) => {
    const date = new Date(post.date);
    const year = date.getFullYear();
    const monthIndex = date.getMonth();
    const monthName = formatMonthName(post.date);
    if (!yearMap.has(year)) yearMap.set(year, new Map());
    const monthMap = yearMap.get(year)!;
    if (!monthMap.has(monthIndex)) monthMap.set(monthIndex, { monthName, posts: [] });
    monthMap.get(monthIndex)!.posts.push(post);
  });

  return [...yearMap.entries()]
    .sort(([a], [b]) => b - a)
    .map(([year, monthMap]) => {
      const months = [...monthMap.entries()].sort(([a], [b]) => b - a);
      return { year, months };
    })
    ;
};

const archiveGroups = buildArchiveGroups(sorted);
const hasFeaturedPosts = featured.length > 0;
const metaDescription = locale === 'zh-CN'
  ? '浏览 Chronicle 的全部博客文章、精选内容和归档列表。'
  : 'Browse Chronicle blog posts, featured content, and the full archive.';
---

<Layout title={t('nav.posts')} settings={settings} locale={locale} meta={{ description: metaDescription }}>
  <div class="blog-container">
    <main class="blog-main">
      <section class="section-block" id="featured-section" style={`display:${hasFeaturedPosts ? 'block' : 'none'};`}>
        <div class="section-header featured">
          <h2 class="section-title">{t('blog.featured')}</h2>
          <button
            type="button"
            class="toggle-btn"
            id="featured-toggle"
            aria-expanded="false"
            style={`display:${featured.length > 3 ? 'inline-block' : 'none'};`}
            data-expand-text={t('blog.expand')}
            data-collapse-text={t('blog.collapse')}
          >
            {t('blog.expand')}
          </button>
        </div>
        <div class="featured-grid" id="featured-grid">
          {featured.map((post) => <BlogPostCard post={post} locale={locale} routeLang={routeLang} featured={true} />)}
        </div>
      </section>

      <section class="section-block">
        <h2 class="section-title">{t('blog.allPosts')}</h2>
        <div class="archive-list" id="archive-list">
          {archiveGroups.map(({ year, months }) => (
            <div class="year-block" data-year={year}>
              <h3 class="year-header">{year}</h3>
              {months.map(([monthIndex, monthInfo]) => (
                <div class="month-row" data-month={monthInfo.monthName} data-month-index={monthIndex}>
                  <div class="month-label"><span>{monthInfo.monthName}</span></div>
                  <div class="month-posts">
                    {monthInfo.posts.map((post) => <BlogPostCard post={post} locale={locale} routeLang={routeLang} />)}
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
        {sorted.length === 0 && (
          <div class="empty">{t('blog.noPostsStartWriting')}</div>
        )}
      </section>
    </main>
  </div>
  <BackToTop />
  
</Layout>

<style>
  .blog-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 40px;
    color: var(--app-text-pri);
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

</style>

<style is:global>
  .section-block {
    margin-bottom: 60px;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 10px;
  }

  .section-header.featured {
    border-bottom: 2px solid var(--featured);
  }

  .section-title {
    font-size: 1.8em;
    margin: 0;
    color: var(--app-text-pri);
    padding-bottom: 0px;
    border-bottom: none;
    display: inline-block;
  }

  .toggle-btn {
    background: transparent;
    border: none;
    color: var(--comp-text-sec);
    padding: 4px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1em;
    transition: all 0.3s;
  }

  .toggle-btn:hover {
    color: var(--comp-text-pri-hvr);
    border: none;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  /* Featured collapse: show the first 3, reveal the rest when expanded */
  #featured-grid > :nth-child(n+4) { display: none; }
  #featured-grid.expanded > :nth-child(n+4) { display: block; }

  .featured-card .card-post-title {
    font-size: 1.1em;
    margin-bottom: 0;
  }

  .featured-card .tag {
    font-size: 0.7em;
  }

  .archive-list {
    margin-top: 20px;
  }

  .year-block {
    margin-bottom: 40px;
  }

  h3.year-header  {
    font-size: 3em;
    font-weight: 800 !important;
    font-variation-settings: 'wght' 800;
    color: var(--comp-text-sec);
    opacity: 0.3;
    margin-top: 2px;
    margin-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
    line-height: 1;
  }

  .month-row {
    display: flex;
    margin-bottom: 20px;
  }

  .month-label {
    width: 60px;
    flex-shrink: 0;
    text-align: right;
    padding-right: 20px;
    padding-top: 14px;
    font-weight: medium;
    font-variation-settings: 'wght' 500;
    color: var(--accent);
    font-size: 1.1em;
  }

  .month-posts {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .post-card {
    padding: 16px;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 0.2s, border-color 0.2s, box-shadow 0.2s;
  }


  .compact-card {
    padding: 14px 16px;
    margin-bottom: 0;
    border-radius: 12px;
    transition: all 0.2s;
  }

  .post-card-line {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .featured-card-layout {
    display: grid;
    gap: 10px;
    min-width: 0;
  }

  .featured-card-date {
    color: var(--comp-text-sec);
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .card-post-title {
    font-size: 1.1em;
    margin: 0;
    font-weight: 600;
    font-variation-settings: 'wght' 600;
    color: var(--comp-text-pri);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1 1 0;
    width: auto;
    min-width: 0;
    line-height: 1.4;
  }

  .post-card-time {
    font-size: 0.85em;
    color: var(--comp-text-sec);
    flex-shrink: 0;
    white-space: nowrap;
    min-width: 24px;
    font-variant-numeric: tabular-nums;
  }

  .compact-card .post-featured-star {
    display: none;
    color: var(--featured);
    font-size: 0.95em;
    line-height: 1;
    flex-shrink: 0;
  }

  .compact-card .post-tags {
    margin-top: 6px;
    margin-left: 30px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .post-tags {
    display: flex;
    gap: 6px;
    flex-wrap: nowrap;
    overflow-x: hidden;
  }

  .tag {
    background: var(--accent-bg);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.75em;
    color: var(--accent);
    display: inline-block;
    line-height: 1;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .tag.featured {
    font-weight: 500;
    font-variation-settings: 'wght' 500;
    background: var(--featured-bg);
    color: var(--featured);
  }

  .empty {
    text-align: center;
    padding: 60px;
    color: var(--comp-text-sec);
  }

  @media (max-width: 768px) {
    .month-label {
      width: 38px;
      padding-right: 12px;
      padding-top: 10px;
    }

    .card-post-title {
      width: 0;
    }

    .featured-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    h3.year-header {
      font-size: 2.2em;
    }

    .post-card {
      padding: 12px 14px;
    }

    .featured-card {
      border-radius: 12px;
      transition: all 0.3s ease;
    }

    .featured-card .card-post-title,
    .compact-card .card-post-title {
      font-size: 0.98rem;
      font-weight: 500;
      font-variation-settings: 'wght' 500;
    }

    .featured-card-layout {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    .featured-card-date {
      order: 2;
      font-size: 0.75rem;
    }

    .featured-card .card-post-title,
    .compact-card .card-post-title {
      order: 1;
      white-space: nowrap;
    }

    .featured-card .post-tags {
      display: none;
    }

    .post-card-line {
      gap: 10px;
    }

    .post-card-line .post-card-time {
      order: 1;
      margin-right: 0;
    }

    .compact-card .post-featured-star {
      order: 2;
      display: inline-flex;
    }

    .post-card-line .card-post-title {
      order: 3;
      flex: 1 1 0;
      min-width: 0;
    }

    .post-card-time {
      font-size: 0.76rem;
      min-width: 16px;
      color: var(--comp-text-sec);
    }

    /* 0-2-0: must beat .compact-card .post-tags (0-2-0, earlier) — plain .post-tags would lose */
    .post-card .post-tags {
      display: none;
    }
  }
</style>

<script>
  // Featured expand/collapse — pure client toggle over SSR-rendered DOM (no fetching).
  // Delegated on document so it survives ViewTransitions client navigation.
  if (!window.__chronicleBlogsFeaturedToggle) {
    window.__chronicleBlogsFeaturedToggle = true;
    document.addEventListener('click', (event) => {
      const btn = event.target instanceof Element ? event.target.closest<HTMLElement>('#featured-toggle') : null;
      if (!btn) return;
      const grid = document.getElementById('featured-grid');
      if (!grid) return;
      const expanded = grid.classList.toggle('expanded');
      btn.textContent = expanded ? (btn.dataset.collapseText ?? '') : (btn.dataset.expandText ?? '');
      btn.setAttribute('aria-expanded', String(expanded));
    });
  }
</script>

