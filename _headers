# Chronicle Aurora — GitHub Pages 自定义响应头
# 缓存策略：HTML 短 TTL（配合 Cloudflare Cache Rule 边缘缓存），指纹资源 immutable。

# 默认：静态资源可缓存
/assets/*
  Cache-Control: public, max-age=86400

# 指纹资源：带内容 hash，永不变
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 页面 HTML：浏览器端短 TTL（5 分钟）——Cloudflare 边缘缓存由 Cache Rule
# 独立控制（可更长），源站 max-age 只约束浏览器与中间层
/en/*
  Cache-Control: public, max-age=300
/zh/*
  Cache-Control: public, max-age=300
/*.html
  Cache-Control: public, max-age=300

# 根页面（/ → /en 重定向等）
/
  Cache-Control: public, max-age=300
